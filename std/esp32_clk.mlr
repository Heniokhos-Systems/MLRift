// MLRift Standard Library — ESP32 CPU clock configuration (XTAL -> PLL)
// ===========================================================================
//
// The ESP32 mask ROM hands control over with SOC_CLK_SEL = XTAL, so a
// freestanding MLRift program runs the CPU **and** the APB bus at the crystal
// frequency — 40 MHz on every board we have. Nothing in the ROM path
// configures the BBPLL, and there is no higher-level ROM function that will do
// it: the entire ESP32-classic mask ROM contains only ets_update_cpu_frequency
// (which writes a software variable and nothing else), ets_get_cpu_frequency,
// ets_get_xtal_scale and the unrelated RF-PLL helpers. All of ESP-IDF's
// rtc_clk.c lives in IDF, not in ROM. So the whole job is the register
// sequence below.
//
// This file takes the CPU to 80, 160 or 240 MHz. It is written for the
// original ESP32 (D0WD / D0WD-V3, Xtensa LX6) with a 40 MHz crystal and is
// NOT valid for ESP32-S2/S3/C3, which have a different analog register bus.
//
// ---------------------------------------------------------------------------
// APB GOES TO 80 MHz AND THAT IS NOT OPTIONAL
// ---------------------------------------------------------------------------
// For all three PLL CPU frequencies the APB bus becomes 80 MHz (IDF's
// rtc_clk_cpu_freq_to_pll_mhz calls rtc_clk_apb_freq_update(80 * MHZ)
// unconditionally). Everything clocked from APB therefore changes rate:
//
//   * UART. The divisor is APB/baud, so 115200 needs 347+3/16 at 40 MHz and
//     694+7/16 at 80 MHz. esp32_clk_uart0_apb80() writes the new divisor, and
//     the caller MUST drain the TX FIFO before switching or the bytes still in
//     it are shifted out at the wrong rate. Forgetting this is the classic
//     failure: the serial line turns to garbage and looks exactly like a hang.
//
//   * REF_TICK. SYSCON_PLL_TICK_CONF must be 79 so REF_TICK stays 1 MHz.
//
//   * The MWDT timeouts halve. We disable all three watchdogs in the entry
//     preamble, so that is moot here. RWDT runs from RTC_SLOW and is unmoved.
//
//   * SPI0/SPI1 flash. The ROM leaves SPI_CLOCK_REG at APB/2, so the flash
//     clock silently goes 20 -> 40 MHz. That is harmless for us because the
//     mask ROM copies both image segments into IRAM and DRAM before the entry
//     point runs and we never read flash again — and 40 MHz is ESP-IDF's own
//     default flash speed anyway.
//
//   * TWAI/CAN bit timing is derived from APB/2. ANY board driving CAN must
//     recompute BRP after calling this, or every bit time is 2x wrong.
//
//   * Also scaling: TIMG timers, LEDC, RMT, I2C, I2S, SPI2/3, UART1/2, SDMMC,
//     EMAC, and the SAR ADC dividers. Untouched: the RTC slow clock and the
//     brownout detector, both RTC-clocked.
//
// ---------------------------------------------------------------------------
// HOW THE ANALOG BBPLL REGISTERS ARE REACHED
// ---------------------------------------------------------------------------
// The BBPLL's dividers are not memory-mapped registers; they live behind an
// on-chip analog serial bus. ESP-IDF reaches them through the ROM's
// rom_i2c_writeReg, and every ESP32 ROM function is compiled for the Xtensa
// WINDOWED ABI (they all begin `entry a1, 0x20` and end `retw.n`). Our entry
// preamble pins PS = 0x2F, i.e. WOE = 0 and EXCM = 1, and `entry` with
// WOE == 0 raises Illegal Instruction — so calling ROM would mean flipping PS
// to 0x0004001F and back around every write, and rom_i2c_writeReg additionally
// dereferences a function-pointer table at 0x3FFAE0C0 that a RAM image can
// overlap.
//
// None of that is necessary. rom_i2c_writeReg is only a dispatcher to
// rom_chip_i2c_writeReg, and THAT function is pure MMIO:
//
//     ctrl = 0x6000E000 + host_id * 4
//     *ctrl = 0x01000000 | block | (reg << 8) | (data << 16)
//     while (*ctrl & 0x02000000) { }        // bit 25 = busy
//
// (Confirmed by disassembling the rev3 mask ROM, and independently by
// ESP-IDF's own i2c_ana_mst_reg.h for a later chip, which documents the same
// IP: bit 25 BUSY read-only, bits 24:0 the command.) I2C_BBPLL is block 0x66
// with host id 4, so the control word lives at 0x6000E010. That is what
// esp32_clk_bbpll_w does, with no ROM call and no PS change.
//
// ---------------------------------------------------------------------------
// LOCK DETECTION: THERE IS NONE
// ---------------------------------------------------------------------------
// regi2c_bbpll.h declares I2C_BBPLL_OR_LOCK1/LOCK2 but nothing in ESP-IDF ever
// reads them. IDF waits a fixed delay after configuring the PLL and so do we.
// ===========================================================================

// The analog-bus control word for I2C_BBPLL (block 0x66, host id 4) and the
// gate register that must let BBPLL traffic through.
//
// These are the AHB (0x6000_Exxx) addresses ROM and IDF both use. Do NOT
// substitute a 0x3FF4_Exxx "APB equivalent" — that alias is unverified.
device EspAnaMst at 0x6000E000 {
    bbpll_ctrl at 0x10 : u32
    ana_config at 0x44 : u32
}

device EspRtcCntl at 0x3FF48000 {
    options0 at 0x00 : u32
    clk_conf at 0x70 : u32
    rtc_reg  at 0x7C : u32
}

device EspDport at 0x3FF00000 {
    cpu_per_conf at 0x3C : u32
}

device EspSyscon at 0x3FF66000 {
    sysclk_conf at 0x00 : u32
    xtal_tick   at 0x04 : u32
    pll_tick    at 0x08 : u32
}

device EspUart0Clk at 0x3FF40000 {
    clkdiv at 0x14 : u32
    status at 0x1C : u32
}

// CCOUNT, for the microsecond delays the sequence needs. Same two-instruction
// @naked accessor as tests/nn/nn_prof_esp32.mlr — see asm_emit_xt in
// src/ir_xtensa.mlr for why the register is baked into the mnemonic.
@naked fn esp32_clk_ccount() -> u32 {
    asm("rsr.ccount a2")
    asm("ret")
    // Unreachable: the asm ret above already returned.
    return 0
}

// Spin for `n` CPU cycles. Cycle-accurate rather than a counted loop, because
// the loop's cost per iteration is not something this file should have to know
// — and because the BBPLL settling delays are specified in real time.
fn esp32_clk_spin(u32 n) {
    u32 t0 = esp32_clk_ccount()
    u32 d = 0
    while d < n {
        d = (esp32_clk_ccount() - t0) & 0xFFFFFFFF
    }
}

// One write to an analog BBPLL register. `reg` is the analog register index,
// `data` the whole byte (these are REGI2C_WRITE full-byte writes, not masked
// read-modify-writes — that is what clk_ll_bbpll_set_config does).
fn esp32_clk_bbpll_w(u32 reg, u32 data) {
    // 0x01000000 = start, 0x66 = I2C_BBPLL block id.
    // ⚠️ MLRift precedence: `|` binds TIGHTER than `<<`, so both shifts MUST
    // be parenthesized or `reg << 8 | data` parses as `reg << (8 | data)`.
    u32 w = 0x01000000 | 0x66 | (reg << 8) | (data << 16)
    EspAnaMst.bbpll_ctrl = w
    // bit 25 = BUSY, read-only. Clears when the analog write has landed.
    while (EspAnaMst.bbpll_ctrl & 0x02000000) != 0 { }
}

// Set RTC_CNTL_REG's DIG_DBIAS_WAK field (bits 13:11) — the digital regulator
// voltage. 480 MHz BBPLL / 240 MHz CPU needs 7; 320 MHz / 80-160 MHz needs 4.
// Getting this wrong is not a numeric error, it is an unstable core.
fn esp32_clk_set_dbias(u32 v) {
    u32 r = EspRtcCntl.rtc_reg
    r = r & 0xFFFFC7FF
    r = r | ((v & 0x7) << 11)
    EspRtcCntl.rtc_reg = r
}

// Recompute UART0's divisor for an 80 MHz APB at 115200 baud.
//
//   clk_div = (80_000_000 << 4) / 115200 = 11111
//   integer part  = 11111 >> 4  = 694  = 0x2B6   -> bits 19:0
//   fractional    = 11111 & 0xF = 7              -> bits 23:20
//
// The 40 MHz value the ROM leaves behind is 347 + 3/16 = 0x0030015B, which is
// exactly what the board reports before this runs — a useful cross-check that
// the APB really was at 40 MHz.
//
// UART_CONF0's TICK_REF_ALWAYS_ON (bit 27) is already 1, i.e. the UART is
// sourced from APB rather than REF_TICK, so only the divisor needs changing.
fn esp32_clk_uart0_apb80() {
    u32 v = 0x007002B6
    EspUart0Clk.clkdiv = v
}

// Block until UART0's TX FIFO has drained, so nothing is still being shifted
// out when the divisor changes underneath it.
fn esp32_clk_uart0_drain() {
    while ((EspUart0Clk.status >> 16) & 0xFF) != 0 { }
    // The FIFO being empty is not the same as the shift register being empty;
    // one character time at 115200 is ~87 us, so 8000 cycles at 40 MHz covers
    // it with margin. (This runs BEFORE the switch, hence 40 MHz.)
    esp32_clk_spin(8000)
}

// Take the CPU to `mhz` (80, 160 or 240) from the ROM's XTAL default.
//
// Returns 0 on success, 1 if `mhz` is not one of the three supported values
// (in which case nothing is written and the CPU stays on the crystal).
//
// THE CALLER OWNS THE UART. This function does not print and does not touch
// UART0 except through esp32_clk_uart0_drain / esp32_clk_uart0_apb80, which it
// calls around the switch itself.
fn esp32_clk_cpu_pll(u32 mhz) -> u32 {
    u32 period_sel = 0
    u32 bbpll_480 = 0
    u32 dbias_run = 4
    if mhz == 80 {
        period_sel = 0
    } else {
        if mhz == 160 {
            period_sel = 1
        } else {
            if mhz == 240 {
                period_sel = 2
                bbpll_480 = 1
                dbias_run = 7
            } else {
                return 1
            }
        }
    }

    // 1. Let BBPLL traffic onto the analog bus. Setting bits 17:8 and then
    //    CLEARING bit 17 (I2C_BBPLL_M) is what regi2c_ctrl_ll's reset +
    //    bbpll_enable pair does; IDF does it once in rtc_clk_init and never
    //    repeats it.
    u32 ana = EspAnaMst.ana_config
    ana = ana | 0x0003FF00
    ana = ana & 0xFFFDFFFF
    EspAnaMst.ana_config = ana

    // 2. Release the analog power-down forces. On a ROM hand-off these are
    //    already clear (OPTIONS0 reads 0x1C492000), but clearing them is what
    //    IDF does and it is idempotent. Note IDF clears the *_FORCE_PD bits and
    //    never sets the matching *_FORCE_PU bits — do not "help" by setting
    //    them.
    //      bit 18 BIAS_I2C_FORCE_PD, bit 10 BBPLL_FORCE_PD,
    //      bit  8 BBPLL_I2C_FORCE_PD, bit 6 BB_I2C_FORCE_PD
    u32 o0 = EspRtcCntl.options0
    o0 = o0 & 0xFFFBFABF
    EspRtcCntl.options0 = o0

    // 3. Normalise the APB pre-divider (must be 0 on the PLL path) and keep
    //    REF_TICK at 1 MHz for the crystal while we are still on it.
    u32 sc = EspSyscon.sysclk_conf
    sc = sc & 0xFFFFFC00
    EspSyscon.sysclk_conf = sc
    u32 xt = 39
    EspSyscon.xtal_tick = xt

    // 4. bbpll_enable — the five fixed analog writes, identical for 320 and
    //    480 MHz.
    esp32_clk_bbpll_w(0, 0x18)          // IR_CAL_DELAY
    esp32_clk_bbpll_w(1, 0x20)          // IR_CAL_EXT_CAP
    esp32_clk_bbpll_w(4, 0x9A)          // OC_ENB_FCAL
    esp32_clk_bbpll_w(10, 0)            // OC_ENB_VCON
    esp32_clk_bbpll_w(12, 0)            // BBADC_CAL_7_0
    esp32_clk_spin(1000)                // >= one RTC_SLOW edge (150 kHz)

    // 5. bbpll_configure. For a 40 MHz crystal the loop filter settings are
    //    div_ref = 0, div10_8 = 0, lref = 0, dcur = 6, bw = 3 for both target
    //    frequencies, so OC_LREF = 0x00 and OC_DCUR = (3<<6)|6 = 0xC6; only
    //    ENDIV5, BBADC_DSMP and the feedback divider OC_DIV_7_0 differ.
    //      480 MHz: ENDIV5 0xC3, DSMP 0x74, DIV_7_0 28
    //      320 MHz: ENDIV5 0x43, DSMP 0x84, DIV_7_0 32
    if bbpll_480 != 0 {
        esp32_clk_set_dbias(7)
        esp32_clk_spin(120)             // 3 us at 40 MHz, 480 MHz only
        esp32_clk_bbpll_w(11, 0xC3)     // ENDIV5
        esp32_clk_bbpll_w(9, 0x74)      // BBADC_DSMP
        esp32_clk_bbpll_w(2, 0)         // OC_LREF
        esp32_clk_bbpll_w(3, 28)        // OC_DIV_7_0
        esp32_clk_bbpll_w(5, 0xC6)      // BBADC_DCUR
    } else {
        esp32_clk_set_dbias(4)
        esp32_clk_bbpll_w(11, 0x43)     // ENDIV5
        esp32_clk_bbpll_w(9, 0x84)      // BBADC_DSMP
        esp32_clk_bbpll_w(2, 0)         // OC_LREF
        esp32_clk_bbpll_w(3, 32)        // OC_DIV_7_0
        esp32_clk_bbpll_w(5, 0xC6)      // BBADC_DCUR
    }
    // IDF's 80 us (RTC_SLOW is RC_SLOW here, per ANA_CLK_RTC_SEL = 0). No lock
    // bit exists to poll; take 4x the margin since we have nothing to lose.
    esp32_clk_spin(12800)               // 320 us at 40 MHz

    // 6. Regulator voltage for the RUNNING frequency, then the period select.
    //    CPUPERIOD_SEL must be written BEFORE SOC_CLK_SEL — IDF calls
    //    clk_ll_cpu_set_freq_mhz_from_pll() before clk_ll_cpu_set_src(). The
    //    whole-register write also clears LOWSPEED_CLK_SEL and FAST_CLK_RTC_SEL,
    //    which is what IDF does and is harmless from a 0 reset value.
    esp32_clk_set_dbias(dbias_run)
    EspDport.cpu_per_conf = period_sel
    u32 pt = 79                         // REF_TICK stays 1 MHz off an 80 MHz APB
    EspSyscon.pll_tick = pt

    // 7. Drain the UART while the divisor still matches the current APB, then
    //    throw the switch and immediately re-divide. Everything between these
    //    two statements runs with a mismatched UART, so nothing may print.
    esp32_clk_uart0_drain()

    u32 cc = EspRtcCntl.clk_conf
    cc = cc & 0xE7FFFFFF                // clear SOC_CLK_SEL (bits 28:27)
    cc = cc | 0x08000000                // SOC_CLK_SEL = 1 (PLL)
    EspRtcCntl.clk_conf = cc

    esp32_clk_uart0_apb80()

    // 8. Settle. 30 us at the NEW clock — the spin is in CPU cycles and the
    //    CPU is now `mhz`, so scale by 240 to be safe at every target.
    esp32_clk_spin(7200)
    return 0
}
