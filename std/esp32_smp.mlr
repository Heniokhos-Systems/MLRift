// ESP32 SMP — APP_CPU (core 1) release.
//
// Two independent stall sources must both be cleared:
//   - DPORT APPCPU_CTRL_C.RUNSTALL
//   - the RTC-domain software stall (survives non-EN resets; ESP-IDF clears
//     it UNCONDITIONALLY, i.e. it does not assume the ROM left it clear)
// Clearing only the first leaves core 1 frozen the instant it leaves reset,
// with the symptom "core 1 never ran" — indistinguishable from a bad
// preamble or a bad stack.
device EspSmpDport at 0x3FF00000 {
    appcpu_ctrl_a at 0x2C : u32     // bit 0 APPCPU_RESETTING
    appcpu_ctrl_b at 0x30 : u32     // bit 0 APPCPU_CLKGATE_EN
    appcpu_ctrl_c at 0x34 : u32     // bit 0 APPCPU_RUNSTALL
    appcpu_ctrl_d at 0x38 : u32     // boot address (whole register)
}

// RTC-domain software stall. The stall is encoded across BOTH fields:
// ESP-IDF stalls the APP CPU by writing 0x21 to C1 (in sw_cpu_stall) and
// 0x2 to C0 (in options0); any other combination means "not stalled".
// SW_STALL_APPCPU_C0 is bits [1:0] of options0 (shift 0, width 2, mask 0x3).
// SW_STALL_APPCPU_C1 is bits [25:20] of sw_cpu_stall (shift 20, width 6,
// mask 0x3F).
device EspSmpRtc at 0x3FF48000 {
    options0 at 0x00 : u32
    sw_cpu_stall at 0xAC : u32
}
