// ESP32 SMP — APP_CPU (core 1) release.
//
// Core-1 stack layout (Minor finding 6). These MUST track the compiler's own
// XT_ESP32_CORE1_STACK in src/ir_xtensa.mlr — the backend's SP-init preamble
// for core1_entry is not driven by these constants (it is compiled into
// ir_xtensa.mlr directly), so a change to one without the other silently
// makes an image guard the wrong addresses. Keep the numbers identical by
// hand; there is no shared header between compiler and stdlib to enforce it.
//   ESP32_C0_GUARD_ADDR   — one word above core 1's SP start, one word below
//                           core 0's floor: only a core-0 stack overflow
//                           reaches it.
//   ESP32_C1_GUARD_ADDR   — core 1's floor: only a core-1 stack overflow
//                           reaches it.
//   ESP32_CORE1_STACK_TOP — core 1's initial SP (== XT_ESP32_CORE1_STACK).
//                           16-byte aligned, 16 bytes below ESP32_C0_GUARD_ADDR.
static u32 ESP32_C0_GUARD_ADDR   = 0x3FFDF000
static u32 ESP32_C1_GUARD_ADDR   = 0x3FFDE000
static u32 ESP32_CORE1_STACK_TOP = 0x3FFDEFF0
//
// Two independent stall sources must both be cleared:
//   - DPORT APPCPU_CTRL_C.RUNSTALL
//   - the RTC-domain software stall (survives non-EN resets; ESP-IDF clears
//     it UNCONDITIONALLY, i.e. it does not assume the ROM left it clear)
// Clearing only the first leaves core 1 frozen the instant it leaves reset,
// with the symptom "core 1 never ran" — indistinguishable from a bad
// preamble or a bad stack.
device EspSmpDport at 0x3FF00000 {
    appcpu_ctrl_a at 0x2C : u32     // bit 0 APPCPU_RESETTING
    appcpu_ctrl_b at 0x30 : u32     // bit 0 APPCPU_CLKGATE_EN
    appcpu_ctrl_c at 0x34 : u32     // bit 0 APPCPU_RUNSTALL
    appcpu_ctrl_d at 0x38 : u32     // boot address (whole register)
}

// RTC-domain software stall. The stall is encoded across BOTH fields:
// ESP-IDF stalls the APP CPU by writing 0x21 to C1 (in sw_cpu_stall) and
// 0x2 to C0 (in options0); any other combination means "not stalled".
// SW_STALL_APPCPU_C0 is bits [1:0] of options0 (shift 0, width 2, mask 0x3).
// SW_STALL_APPCPU_C1 is bits [25:20] of sw_cpu_stall (shift 20, width 6,
// mask 0x3F).
device EspSmpRtc at 0x3FF48000 {
    options0 at 0x00 : u32
    sw_cpu_stall at 0xAC : u32
}

// Clear both stall fields. Neither alone is "not stalled" — ESP-IDF's own
// stall write is 0x21 into SW_STALL_APPCPU_C1 (sw_cpu_stall bits 25:20) AND
// 0x2 into SW_STALL_APPCPU_C0 (options0 bits 1:0). We clear unconditionally,
// the same way ESP-IDF does, rather than assuming the ROM already left them
// clear.
//
// ⚠️ `&` binds TIGHTER than `>>`/`<<` in this dialect (opposite of C), so the
// masks below are plain hex constants, not shift expressions, to avoid the
// hazard entirely.
fn esp32_rtc_unstall_appcpu() {
    // SW_STALL_APPCPU_C1: bits [25:20] of sw_cpu_stall (mask 0x03F00000).
    EspSmpRtc.sw_cpu_stall = EspSmpRtc.sw_cpu_stall & 0xFC0FFFFF
    // SW_STALL_APPCPU_C0: bits [1:0] of options0 (mask 0x3).
    EspSmpRtc.options0 = EspSmpRtc.options0 & 0xFFFFFFFC
}

// Order is load-bearing. Clear the stalls first, pulse reset while the core is
// gated OFF, then arm the boot address, then ungate. The APP CPU's mask ROM
// polls CTRL_D and jumps when it is non-zero.
fn esp32_appcpu_start(u32 entry_addr) {
    // 1. both stall sources (RTC first — it survives non-EN resets)
    esp32_rtc_unstall_appcpu()
    EspSmpDport.appcpu_ctrl_c = EspSmpDport.appcpu_ctrl_c & 0xFFFFFFFE
    // 2. gate the clock off before touching reset
    EspSmpDport.appcpu_ctrl_b = EspSmpDport.appcpu_ctrl_b & 0xFFFFFFFE
    // 3. pulse reset
    EspSmpDport.appcpu_ctrl_a = EspSmpDport.appcpu_ctrl_a | 1
    EspSmpDport.appcpu_ctrl_a = EspSmpDport.appcpu_ctrl_a & 0xFFFFFFFE
    // 4. arm the boot address
    EspSmpDport.appcpu_ctrl_d = entry_addr
    // 5. ungate — this starts it
    EspSmpDport.appcpu_ctrl_b = EspSmpDport.appcpu_ctrl_b | 1
}
