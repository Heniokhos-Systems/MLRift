// ESP32 UART0 output. Shared by every ESP32 image in the dual-core work so
// there is one definition of the errata workaround and one of the hex printer.
//
// Two device blocks, not one: a single `device Uart at <base>` cannot express
// "poll here, write there". Errata CPU-3.3 requires the TX byte to go to the
// AHB mirror at 0x60000000, while status is read from 0x3FF40000.
device UartStatus at 0x3FF40000 {
    status at 0x1C : u32
}
device UartFifo at 0x60000000 {
    fifo at 0x00 : u32
}

fn putc(u8 c) {
    // TXFIFO_CNT is bits 23:16 of UART_STATUS_REG. Wait while the 128-deep
    // FIFO holds >= 126 bytes, leaving headroom rather than filling it.
    //
    // ⚠️ `&` binds TIGHTER than `>>` in this dialect (the opposite of C), so
    // the shift MUST be parenthesized. Written bare, `status >> 16 & 0xFF`
    // parses as `status >> (16 & 0xFF)` — a silently wrong mask.
    while ((UartStatus.status >> 16) & 0xFF) >= 126 { }
    UartFifo.fifo = c
}

fn puts(u32 s) {
    u32 i = 0
    u32 ch = load8(s + i)
    while ch != 0 {
        putc(ch)
        i = i + 1
        ch = load8(s + i)
    }
}

// Fixed 8-nibble hex. No division and no table — a decimal printer needs both,
// and hex is what you want when reading a raw serial capture.
fn puthex32(u32 v) {
    u32 sh = 28
    while 1 != 0 {
        u32 n = (v >> sh) & 0xF
        if n < 10 { putc(48 + n) } else { putc(87 + n) }
        if sh == 0 { return }
        sh = sh - 4
    }
}

// Counted busy-wait, roughly a second at 240 MHz. We are pacing a human
// watching a terminal, not timing a protocol.
fn delay() {
    u32 i = 0
    while i < 4000000 {
        i = i + 1
    }
}
