// Signed integer formatting through BOTH the variadic print path
// (println("x=", n)) and f-strings (println(f"x={n}")). Legacy printed
// the raw two's-complement pattern for negative int64 values until both
// were fixed to match the IR backend's signed formatting.
fn main() {
    int64 a = 0 - 42
    println("a=", a)
    println(f"a={a}")
    int64 b = 0 - 1234567
    println("b=", b)
    println(f"b={b}")
    int64 z = 0
    println("z=", z)
    println(f"z={z}")
    int64 p = 42
    println("p=", p)
    println(f"p={p}")
    uint64 u = 99
    println("u=", u)
    println(f"u={u}")
    int64 mn = (0 - 9223372036854775807) - 1
    println("mn=", mn)
    println(f"mn={mn}")
    exit(0)
}
