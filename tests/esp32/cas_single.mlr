import "../../std/esp32_clk.mlr"
import "../../std/esp32_uart.mlr"

static u32[1] cell

fn main() {
    u32 clkrc = esp32_clk_cpu_pll(240)
    vstore32(cell, 100)
    u32 ok_hit  = atomic_cas(cell, 100, 200)   // expect 1, cell -> 200
    u32 ok_miss = atomic_cas(cell, 100, 300)   // expect 0, cell stays 200
    loop {
        puts("HIT ")   puthex32(ok_hit)
        puts(" MISS ") puthex32(ok_miss)
        puts(" CELL ") puthex32(vload32(cell))
        puts("\r\n")
        delay()
    }
}
