import "../../std/esp32_clk.mlr"
import "../../std/esp32_smp.mlr"
import "../../std/esp32_uart.mlr"

static u32[1] shared
static u32[1] c1_done
static u32[1] c0_retries
static u32[1] c1_retries

// Guard-word canary (Minor finding 6). This test has the deepest core-1 call
// chain in the branch (core1_entry -> bump/bump_p -> spin, all CALL0 frames
// on core 1's stack) and, unlike examples/esp32/dualcore_hello.mlr, had no
// guards at all — the exact case a core-1 stack overflow would corrupt core
// 0's globals silently. Addresses are the named constants in
// std/esp32_smp.mlr, not hardcoded, so a change to XT_ESP32_CORE1_STACK
// cannot silently leave these guarding the wrong bytes.
static u32 CANARY = 0xCA5AB0DE

fn stack_prep() {
    vstore32(ESP32_C0_GUARD_ADDR, CANARY)
    vstore32(ESP32_C1_GUARD_ADDR, CANARY)
}

fn stack_report() {
    puts("C0GUARD ") puthex32(vload32(ESP32_C0_GUARD_ADDR))
    puts(" C1GUARD ") puthex32(vload32(ESP32_C1_GUARD_ADDR))
    puts("\r\n")
}

// Phase C: a deliberate correctness PROBE, not a benchmark. Separate word
// and separate counters from phase A/B so the honest performance figures
// above are never touched by this. Phase A/B never observed a single failed
// CAS on this board (see the fix-round report), meaning the CAS failure
// path itself — materialise 0, fall through, re-read, retry — has never
// actually executed on this silicon. Widening core 1's window between its
// vload32 and its atomic_cas deterministically (not randomly, so the run
// stays reproducible) forces that path to run.
static u32[1] shared_p
static u32[1] c0_ready_p
static u32[1] c1_done_p
static u32[1] c0_retries_p
static u32[1] c1_retries_p

// `retry_ctr` is a static u32[1]'s address, passed the same way
// std/nn_int8.mlr's nn_store_i32(u32 p, ...) takes one: the array name
// decays to its address as a plain u32.
fn bump(u32 n, u32 retry_ctr) {
    u32 i = 0
    while i < n {
        loop {
            u32 cur = vload32(shared)
            if atomic_cas(shared, cur, cur + 1) != 0 { break }
            // Failed CAS: another core wrote `shared` between our vload32
            // and our atomic_cas. Counting these is the only way to prove
            // the two cores actually interleaved on the word, rather than
            // core 1 having simply finished before core 0 ever started.
            vstore32(retry_ctr, vload32(retry_ctr) + 1)
        }
        i = i + 1
    }
}

// Plain counted busy-wait — no CCOUNT read, deliberately cheap, used only to
// widen the collision window a fixed, reproducible amount. Not a benchmark
// primitive.
fn spin(u32 n) {
    u32 i = 0
    while i < n {
        i = i + 1
    }
}

// Same shape as bump(), but operates on shared_p and can widen the window
// between the read and the CAS by `delay` spin iterations. `delay` is 0 for
// core 0 and a fixed nonzero constant for core 1 only — deterministic, not
// randomised, so the probe stays reproducible run to run.
fn bump_p(u32 n, u32 retry_ctr, u32 delay) {
    u32 i = 0
    while i < n {
        loop {
            u32 cur = vload32(shared_p)
            if delay != 0 { spin(delay) }
            if atomic_cas(shared_p, cur, cur + 1) != 0 { break }
            vstore32(retry_ctr, vload32(retry_ctr) + 1)
        }
        i = i + 1
    }
}

fn core1_entry() {
    EspSmpDport.appcpu_ctrl_d = 0
    bump(10000, c1_retries)
    vstore32(c1_done, 1)
    // Phase C: wait for core 0 to zero the phase-C state before touching
    // shared_p — same "core 0 zeroes before core 1 reads" discipline as the
    // top-level shared/c1_done, just enforced with an explicit handshake
    // flag here because core 1 is already running by this point.
    loop { if vload32(c0_ready_p) != 0 { break } }
    bump_p(2000, c1_retries_p, 300)
    vstore32(c1_done_p, 1)
    loop { }
}

fn main() {
    u32 clkrc = esp32_clk_cpu_pll(240)
    stack_prep()
    vstore32(shared, 0)
    vstore32(c1_done, 0)
    vstore32(c0_retries, 0)
    vstore32(c1_retries, 0)
    // Phase C state, zeroed here too (before core 1 is released) even
    // though core 1 does not read shared_p/c1_done_p until well after phase
    // B — same "never rely on .bss" discipline as the rest of this file.
    vstore32(shared_p, 0)
    vstore32(c0_ready_p, 0)
    vstore32(c1_done_p, 0)
    vstore32(c0_retries_p, 0)
    vstore32(c1_retries_p, 0)

    // Phase A: uncontended baseline. Core 1 is still held in reset/stall
    // (esp32_appcpu_start has not been called yet), so this is the same
    // bump() code path with no other core touching `shared` — the
    // intrinsic MEMW/WSR/RSYNC/S32C1I cost with zero contention.
    u32 ta0 = esp32_clk_ccount()
    bump(10000, c0_retries)
    u32 ta1 = esp32_clk_ccount()
    u32 delta_a = (ta1 - ta0) & 0xFFFFFFFF

    // Reset shared for phase B. Both cores add 10000 each starting from 0
    // again, so the expected total after phase B is still 00004E20 — the
    // pass criterion below states this explicitly rather than relying on
    // phase A's leftover value.
    vstore32(shared, 0)

    // Phase B: release core 1, race it on the same shared word. Same code
    // path as phase A, same clock, so the CCOUNT delta between the two
    // phases isolates the marginal cost of real two-core contention.
    esp32_appcpu_start(fn_addr("core1_entry"))
    u32 tb0 = esp32_clk_ccount()
    bump(10000, c0_retries)
    u32 tb1 = esp32_clk_ccount()
    u32 delta_b = (tb1 - tb0) & 0xFFFFFFFF

    loop { if vload32(c1_done) != 0 { break } }

    // Phase C: correctness PROBE, not a benchmark — see the comment on the
    // phase-C statics above. shared_p/c1_done_p/etc. were already zeroed at
    // the top of main(), before core 1 was ever released, so it is safe to
    // signal readiness now without a fresh zero here. Core 0 runs bump_p
    // with delay=0 (unwidened); core 1, released back in core1_entry after
    // it finishes phase B, runs with a fixed 300-iteration spin between its
    // vload32 and its atomic_cas, deterministically forcing the CAS failure
    // path to execute at least once.
    vstore32(c0_ready_p, 1)
    bump_p(2000, c0_retries_p, 0)
    loop { if vload32(c1_done_p) != 0 { break } }

    loop {
        puts("PHASE_A_CCOUNT ") puthex32(delta_a)
        puts(" PHASE_B_CCOUNT ") puthex32(delta_b)
        puts("\r\n")
        puts("TOTAL ") puthex32(vload32(shared))
        puts(" EXPECT 00004E20\r\n")
        puts("C0_RETRIES ") puthex32(vload32(c0_retries))
        puts(" C1_RETRIES ") puthex32(vload32(c1_retries))
        puts("\r\n")
        puts("PROBE_TOTAL ") puthex32(vload32(shared_p))
        puts(" PROBE_EXPECT 00000FA0\r\n")
        puts("PROBE_C0_RETRIES ") puthex32(vload32(c0_retries_p))
        puts(" PROBE_C1_RETRIES ") puthex32(vload32(c1_retries_p))
        puts("\r\n")
        // Guard: PROBE_C1_RETRIES == 0 means the widened window did not
        // overlap the load->CAS race on this boot — the probe proved
        // nothing about the failure path, silently, exactly the vacuous
        // outcome it exists to catch. Make that loud instead of letting
        // PROBE_TOTAL's correctness alone imply the probe passed.
        if vload32(c1_retries_p) != 0 {
            puts("PROBE_STATUS PASS\r\n")
        } else {
            puts("PROBE_STATUS FAIL-NO-COLLISIONS\r\n")
        }
        stack_report()
        delay()
    }
}
