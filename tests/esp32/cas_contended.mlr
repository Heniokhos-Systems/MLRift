import "../../std/esp32_clk.mlr"
import "../../std/esp32_smp.mlr"
import "../../std/esp32_uart.mlr"

static u32[1] shared
static u32[1] c1_done

fn bump(u32 n) {
    u32 i = 0
    while i < n {
        loop {
            u32 cur = vload32(shared)
            if atomic_cas(shared, cur, cur + 1) != 0 { break }
        }
        i = i + 1
    }
}

fn core1_entry() {
    EspSmpDport.appcpu_ctrl_d = 0
    bump(10000)
    vstore32(c1_done, 1)
    loop { }
}

fn main() {
    u32 clkrc = esp32_clk_cpu_pll(240)
    vstore32(shared, 0)
    vstore32(c1_done, 0)
    esp32_appcpu_start(fn_addr("core1_entry"))
    u32 t0 = esp32_clk_ccount()
    bump(10000)
    u32 t1 = esp32_clk_ccount()
    // CCOUNT wraps as a plain 32-bit counter; masking matches the pattern
    // esp32_clk_spin already uses for the same reason.
    u32 delta = (t1 - t0) & 0xFFFFFFFF
    loop { if vload32(c1_done) != 0 { break } }
    loop {
        puts("TOTAL ") puthex32(vload32(shared))
        puts(" EXPECT 00004E20")
        puts(" CCOUNT ") puthex32(delta)
        puts("\r\n")
        delay()
    }
}
