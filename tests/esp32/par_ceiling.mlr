// tests/esp32/par_ceiling.mlr — Stage 4: the HONEST two-core ceiling.
//
// par_tax.mlr showed the second-core tax is instruction-fetch contention and
// par_park_cost.mlr showed RUNSTALL removes it for ~150 cycles a round. Neither
// answers the question Task 6 actually turns on, because fetch contention does
// not go away while both cores are genuinely working — it is the price of two
// cores running at once, and it caps the split at less than 2x no matter how
// perfect the split is.
//
// So this measures that cap directly instead of deriving it. One elementwise
// kernel — read a byte, add one, store it, the exact shape of NN opcodes 4/6/8/9
// — run three ways over identical total work:
//
//   SOLO    core 1 PARKED with RUNSTALL, core 0 does the whole range. This is
//           the true single-core baseline and the denominator that matters.
//   SPLIT   core 1 woken, both cores do half each, core 0 joins on core 1, core
//           1 parked again. The park and the un-park are INSIDE the timed
//           region because Task 6 would pay them every round.
//   SPIN    core 1 awake and polling, core 0 does the whole range alone. The
//           Task 5 SERIAL shape, kept as the row that shows what the old
//           baseline was measuring.
//
// SOLO/SPLIT is the achievable speedup for perfectly-splittable work with the
// park in place. It is NOT 2x and cannot be: both cores fetch from the same
// SRAM0 bank, and par_tax.mlr measured that costs ~1.3x on this kernel shape.
//
// Poisoning: buf_b is refilled with a sentinel before every timed run, and the
// checksum of buf_b is printed after each. A SPLIT that silently failed to run
// core 1's half would otherwise inherit the previous run's correct bytes and
// print a plausible number — the exact failure tests/nn/nn_par_esp32.mlr's
// nn_par_poison exists to prevent, reproduced here for the same reason.
//
// Build + flash:
//   ./build/mlrc --arch=xtensa --freestanding --target=esp32 \
//                tests/esp32/par_ceiling.mlr -o ceil.bin
//   ~/esp32_flash.sh ceil.bin && ~/esp32_run.sh 45 out.txt
import "../../std/esp32_clk.mlr"
import "../../std/esp32_smp.mlr"
import "../../std/esp32_uart.mlr"

@naked fn ceil_ccount() -> u32 {
    asm("rsr.ccount a2")
    asm("ret")
    return 0
}

static u32[1] c1_ready
static u32[1] c1_go
static u32[1] c1_done
static u32[1] c1_lo
static u32[1] c1_hi

static u8[16384] buf_a
static u8[16384] buf_b
static u8[16] dec_buf

static u32 REPS = 8
static u32 N = 16384

fn putu32(u32 v) {
    u32 x = v
    if x == 0 { putc(48) return }
    u32 i = 0
    while x != 0 {
        store8(dec_buf + i, 48 + (x % 10))
        x = x / 10
        i = i + 1
    }
    while i != 0 {
        i = i - 1
        putc(load8(dec_buf + i))
    }
}

// The kernel. Byte in, byte out, one flat index space — split at any point and
// the two halves name disjoint output bytes.
fn band(u32 lo, u32 hi, u32 reps) -> u32 {
    u32 p = buf_a
    u32 q = buf_b
    u32 r = 0
    u32 a = 0
    while r < reps {
        u32 i = lo
        while i < hi {
            u8 v = load8(p + i)
            store8(q + i, v + 1)
            a = a + v
            i = i + 1
        }
        r = r + 1
    }
    return a
}

fn core1_entry() {
    EspSmpDport.appcpu_ctrl_d = 0
    loop { if vload32(c1_ready) != 0 { break } }
    u32 seen = 0
    loop {
        loop {
            u32 g = vload32(c1_go)
            if g != seen { seen = g  break }
        }
        u32 s = band(vload32(c1_lo), vload32(c1_hi), REPS)
        vstore32(c1_done, vload32(c1_done) + (s & 0) + 1)
    }
}

fn appcpu_runstall(u32 on) {
    if on != 0 {
        EspSmpDport.appcpu_ctrl_c = EspSmpDport.appcpu_ctrl_c | 1
    } else {
        EspSmpDport.appcpu_ctrl_c = EspSmpDport.appcpu_ctrl_c & 0xFFFFFFFE
    }
}

// 0x5A into every output byte before every timed run. Nothing may read the
// previous run's answers.
fn poison() {
    u32 i = 0
    while i < 16384 {
        store8(buf_b + i, 0x5A)
        i = i + 1
    }
}

// Sum of buf_b, printed after every run. Same for all three modes or one of
// them did not do the work it claimed.
fn checksum() -> u32 {
    u32 i = 0
    u32 s = 0
    while i < 16384 {
        s = s + load8(buf_b + i)
        i = i + 1
    }
    return s
}

fn main() {
    u32 clkrc = esp32_clk_cpu_pll(240)
    puts("CLK ") putu32(clkrc) puts("\r\n")
    u32 i = 0
    while i < 16384 {
        store8(buf_a + i, i & 0xFF)
        i = i + 1
    }
    vstore32(c1_ready, 0)
    vstore32(c1_go, 0)
    vstore32(c1_done, 0)
    vstore32(c1_lo, 8192)
    vstore32(c1_hi, N)

    // Core-1-in-reset reference, for continuity with par_tax.mlr's RESET row.
    poison()
    u32 r0 = ceil_ccount()
    u32 rs = band(0, N, REPS)
    u32 r1 = ceil_ccount()
    puts("RESET ") putu32((r1 - r0) & 0xFFFFFFFF)
    puts(" CHK ") putu32(checksum())
    puts(" SINK ") putu32(rs) puts("\r\n")

    esp32_appcpu_start(fn_addr("core1_entry"))
    vstore32(c1_ready, 1)
    // Prove core 1 is alive before parking it, or every SOLO row below is
    // measuring a core that never started.
    vstore32(c1_go, vload32(c1_go) + 1)
    loop { if vload32(c1_done) != 0 { break } }
    puts("core 1 alive\r\n")

    u32 pass = 0
    while pass < 6 {
        // ---- SOLO: core 1 parked, core 0 does everything ----
        appcpu_runstall(1)
        poison()
        u32 a0 = ceil_ccount()
        u32 sa = band(0, N, REPS)
        u32 a1 = ceil_ccount()
        u32 ca = checksum()

        // ---- SPLIT: wake, half each, join, park. All of it timed. ----
        poison()
        u32 d0 = vload32(c1_done)
        u32 b0 = ceil_ccount()
        appcpu_runstall(0)
        vstore32(c1_go, vload32(c1_go) + 1)
        u32 sb = band(0, 8192, REPS)
        loop { if vload32(c1_done) != d0 { break } }
        appcpu_runstall(1)
        u32 b1 = ceil_ccount()
        u32 cb = checksum()

        // ---- SPIN: core 1 awake and polling c1_go, core 0 alone ----
        appcpu_runstall(0)
        poison()
        u32 c0 = ceil_ccount()
        u32 sc = band(0, N, REPS)
        u32 c1 = ceil_ccount()
        u32 cc = checksum()
        appcpu_runstall(1)

        puts("PASS ") putu32(pass)
        puts(" SOLO ")  putu32((a1 - a0) & 0xFFFFFFFF)
        puts(" SPLIT ") putu32((b1 - b0) & 0xFFFFFFFF)
        puts(" SPIN ")  putu32((c1 - c0) & 0xFFFFFFFF)
        puts(" CHK ")   putu32(ca)
        putc(47)        putu32(cb)
        putc(47)        putu32(cc)
        puts(" SINK ")  putu32(((sa + sb) + sc) & 0xFFFFFFFF)
        puts("\r\n")
        pass = pass + 1
    }
    loop { }
}
