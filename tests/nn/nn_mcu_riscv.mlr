// tests/nn/nn_mcu_riscv.mlr — freestanding riscv32 driver for the int8 kernel
// numeric validation. Same body as nn_host.mlr / nn_mcu.mlr; only the
// character sink differs.
//
// Build + run:
//   mlrc --arch=riscv32 --freestanding tests/nn/nn_mcu_riscv.mlr -o /tmp/nn.bin
//   qemu-system-riscv32 -M virt -nographic -bios /tmp/nn.bin
//
// --freestanding riscv32 emits a FLAT image mapped at 0x8000_0000 (see
// src/ir_riscv.mlr rv_emit_raw_sp_preamble), which is what `-bios` loads.
// virt's console is an NS16550A at 0x1000_0000 with 1-byte registers:
// THR @0x00, LSR @0x05 (bit 5 = transmit holding register empty).
import "nn_test_core.mlr"

device Uart at 0x10000000 {
    thr at 0x00 : u8
    lsr at 0x05 : u8
}

fn nn_t_putc(u8 c) {
    while (Uart.lsr & 0x20) == 0 { }
    Uart.thr = c
}

fn main() {
    nn_t_run()
    nn_t_putc(69)
    nn_t_putc(78)
    nn_t_putc(68)
    nn_t_putc(10)
    loop { }
}
