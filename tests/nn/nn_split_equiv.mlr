// tests/nn/nn_split_equiv.mlr — host-only SUB-RANGE equivalence check for the
// partitioned kernel variants in std/nn_int8.mlr.
//
// WHY THIS EXISTS, and what it catches that nothing else does.
//
// tests/nn/run_nn_tests.sh proves the kernels are byte-exact against an
// independent Python reference — but it only ever calls them over their FULL
// range. A `_rows`/`_range` variant that is correct for [0, h) yet broken for
// some proper sub-range (a hoisted value that silently assumes oy == 0, an
// off-by-one at a band boundary, an output pointer that gets double-offset)
// passes every existing gate and first misbehaves once the work is actually
// split across two cores — on silicon, where diagnosis is far harder.
//
// The check is the algebraic identity the whole parallel decomposition rests
// on: for every split point k,
//
//     kernel(0, h)  ==  kernel(0, k) followed by kernel(k, h)
//
// byte for byte over the entire output. Run the full range into buffer A, run
// the two bands into buffer B, compare. Nothing here needs a board, a model,
// or Python.
//
// Splits are tested EXHAUSTIVELY: every k in [0, h] for every configuration,
// which subsumes "use an odd split" — it covers odd k, k != h/2, and the two
// degenerate empty-band cases k == 0 and k == h. Several configurations are
// chosen to have an ODD extent, because the smoke model's out_h values are all
// even (8, 4, 4, 8) and a bug that only shows when a split lands mid-something
// would otherwise never be exercised.
//
// Buffer B is pre-poisoned before the split runs, so a variant that writes
// nothing at all is a mismatch rather than an accidental pass.

// std/nn_model.mlr pulls in std/nn_int8.mlr; the dispatch section at the bottom
// needs the model runner as well as the raw kernels.
import "../../std/nn_model.mlr"

// Every buffer here is a fixed-size static and the statics are laid out back to
// back, so an oversized configuration does not fault — it walks quietly into the
// next one. The bias/mult/shift trio is the dangerous case, because what sits
// immediately after it is this program's own bookkeeping:
//
//   nn_se_bias | nn_se_mult | nn_se_shift | nn_se_cbuf | nn_se_seed |
//   nn_se_fails | nn_se_checks
//
// A future case with out_c > NN_SE_QUANT (YuNet-class layers are 16/32/64, so
// this ceiling is TIGHT) would run nn_se_fill_quant off the end of nn_se_shift,
// through nn_se_cbuf, and straight into nn_se_fails and nn_se_checks — BEFORE a
// single comparison had run. If the garbage that landed in nn_se_fails happened
// to be zero, the program would exit 0 with an entirely plausible `checks=`
// line: a silent false PASS in the one gate standing between a partitioning bug
// and silicon. So every case declares its footprint up front via nn_se_need()
// and dies loudly instead. Keep the declarations in step when adding cases.
static u32 nn_se_cap   = 1024      // nn_se_in / in2 / wt / a / b
static u32 nn_se_quant = 16        // nn_se_bias / mult / shift, in elements
static u32 nn_se_guard = 16        // trailing guard band inside nn_se_a/b

static u32 nn_se_arena = 1024      // nn_se_ar, the dispatch section's fake arena
static u32 nn_se_ar_out = 512      // where a dispatch case's output tensor sits

static u8[1024] nn_se_in
static u8[1024] nn_se_in2
static u8[1024] nn_se_wt
static u8[1024] nn_se_a
static u8[1024] nn_se_b
static u8[256]  nn_se_lut
// The dispatch section's scratch: one activation arena and one hand-built
// 160-byte KRNN layer record. The record is u32[40] rather than u8[160] so its
// base is word-aligned for the store32/nn_store_i32 field writes.
static u8[1024] nn_se_ar
static u32[40]  nn_se_rec
static i32[16]  nn_se_bias
static i32[16]  nn_se_mult
static i32[16]  nn_se_shift
static u8[2]    nn_se_cbuf
static u32 nn_se_seed = 0
static u32 nn_se_fails = 0
static u32 nn_se_checks = 0

// The deliberate-failure switch. Passing any argv[1] shifts the SECOND band's
// start up by one, so exactly one row/element of every split is left unwritten.
// That MUST make this program report mismatches and exit non-zero. A harness
// that has never been observed to fail proves nothing, so run_nn_tests.sh runs
// the program twice — clean, then perturbed — and only reports PASS when the
// clean run is green AND the perturbed run is red.
static u32 nn_se_perturb = 0

// Opt in to the compiler's argc/argv plumbing: declaring these two names makes
// main()'s prologue populate them.
static u64 cli_argc = 0
static u64 cli_argv = 0


// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------

fn nn_se_putc(u8 c) {
    u32 p = nn_se_cbuf
    store8(p, c)
    store8(p + 1, 0)
    print_str(p)
}

fn nn_se_emit_u32(u32 v) {
    if v == 0 {
        nn_se_putc(48)
        return
    }
    u32 div = 1000000000
    u32 started = 0
    while div > 0 {
        u32 d = (v / div) % 10
        if d != 0 { started = 1 }
        if started != 0 { nn_se_putc(d + 48) }
        div = div / 10
    }
}

// Capacity assertion. `want` is what a case is about to write, `have` is what
// the static actually holds. Overrunning a harness buffer here does not crash;
// it silently rewrites the pass/fail counters (see the layout note above), so
// this is a hard stop with its own exit code rather than a recorded failure —
// the counters cannot be trusted once a buffer has been overrun.
fn nn_se_need(u32 have, u32 want, u32 which) {
    if want > have {
        print_str("ERROR: harness buffer ")
        nn_se_emit_u32(which)
        print_str(" too small: need ")
        nn_se_emit_u32(want)
        print_str(", have ")
        nn_se_emit_u32(have)
        print_str(" -- widen the static in nn_split_equiv.mlr\n")
        exit(3)
    }
}

// Compare the two buffers over `n` bytes and report the first divergence, then
// check the guard band in BOTH buffers.
//
// The guard exists because comparing only [0, n) catches a kernel that writes
// too LITTLE but not one that writes too MUCH: an overrun past the end of the
// output tensor shows up only indirectly, via the poison it failed to overwrite
// somewhere else, and in Task 5/6 banding it would land in the next tensor
// rather than in slack. Bytes [n, n + nn_se_guard) are poisoned by nn_se_poison
// and must still be poison when the kernel is done.
fn nn_se_cmp(u32 n, u32 k) {
    nn_se_checks = nn_se_checks + 1
    u32 a = nn_se_a
    u32 b = nn_se_b
    u32 i = 0
    while i < n {
        if load8(a + i) != load8(b + i) {
            nn_se_fails = nn_se_fails + 1
            print_str("  MISMATCH split k=")
            nn_se_emit_u32(k)
            print_str(" at byte ")
            nn_se_emit_u32(i)
            print_str(": full=")
            nn_se_emit_u32(load8(a + i) & 0xFF)
            print_str(" split=")
            nn_se_emit_u32(load8(b + i) & 0xFF)
            print_str("\n")
            return
        }
        i = i + 1
    }
    u32 g = 0
    while g < nn_se_guard {
        i32 ga = load8(a + (n + g)) & 0xFF
        i32 gb = load8(b + (n + g)) & 0xFF
        if ga != 0x5A {
            nn_se_fails = nn_se_fails + 1
            print_str("  OVERRUN split k=")
            nn_se_emit_u32(k)
            print_str(": full range wrote ")
            nn_se_emit_u32(ga)
            print_str(" at guard byte ")
            nn_se_emit_u32(n + g)
            print_str("\n")
            return
        }
        if gb != 0x5A {
            nn_se_fails = nn_se_fails + 1
            print_str("  OVERRUN split k=")
            nn_se_emit_u32(k)
            print_str(": split wrote ")
            nn_se_emit_u32(gb)
            print_str(" at guard byte ")
            nn_se_emit_u32(n + g)
            print_str("\n")
            return
        }
        g = g + 1
    }
}

// The second band's start. Identical to `k` unless the deliberate-failure
// switch is on, in which case it skips one row/element.
fn nn_se_pk(u32 k, u32 h) -> u32 {
    if nn_se_perturb != 0 {
        if k < h { return k + 1 }
    }
    return k
}


// ---------------------------------------------------------------------------
// Deterministic input
// ---------------------------------------------------------------------------

fn nn_se_r32() -> u32 {
    u32 s = nn_se_seed
    s = ((s * 1103515245) + 12345) & 0xFFFFFFFF
    nn_se_seed = s
    return s
}

fn nn_se_fill(u32 p, u32 n) {
    u32 i = 0
    while i < n {
        u32 v = (nn_se_r32() >> 16) & 0xFF
        store8(p + i, v)
        i = i + 1
    }
}

// Poison a buffer with a value the kernels are very unlikely to produce
// everywhere, so "wrote nothing" cannot masquerade as "wrote the right thing".
// The poison runs nn_se_guard bytes PAST the region the kernel owns; nn_se_cmp
// asserts that tail survived, which is what turns "wrote too much" from an
// indirect symptom into a direct one.
fn nn_se_poison(u32 p, u32 n) {
    u32 i = 0
    u32 lim = n + nn_se_guard
    while i < lim {
        store8(p + i, 0x5A)
        i = i + 1
    }
}

// Per-channel requantization parameters for the convolution cases. The exact
// values are irrelevant — both sides of every comparison use the same ones —
// but they are drawn from the same ranges TFLite produces (a multiplier
// normalised into [2^30, 2^31) and a negative shift) so the requantizer is
// exercised on its real domain rather than on a degenerate identity. The 30-bit
// addend is what makes the multiplier span the FULL normalised interval and
// stay a positive i32 (0x40000000 + 0x3FFFFFFF == 0x7FFFFFFF).
//
// The caller MUST have asserted n <= nn_se_quant first: nn_se_fails and
// nn_se_checks sit a short way past nn_se_shift.
fn nn_se_fill_quant(u32 n) {
    u32 bp = nn_se_bias
    u32 mp = nn_se_mult
    u32 sp = nn_se_shift
    u32 i = 0
    while i < n {
        i32 bx = nn_u32_to_i32(nn_se_r32())
        nn_store_i32(bp + (i * 4), bx >> 20)
        u32 m = 0x40000000 + ((nn_se_r32() >> 2) & 0x3FFFFFFF)
        nn_store_i32(mp + (i * 4), nn_u32_to_i32(m))
        u32 svu = (nn_se_r32() >> 28) % 12
        i32 sv = svu
        nn_store_i32(sp + (i * 4), (0 - sv) - 1)
        i = i + 1
    }
}


// ---------------------------------------------------------------------------
// Spatial kernels — split on output ROWS
// ---------------------------------------------------------------------------

// nn_conv2d_int8 is the one kernel here that does NOT address its output from
// `oy`: it walks a single running pointer on the invariant that the output is
// written strictly in order, so its `_rows` variant has to re-base that pointer
// to the first byte of row oy_lo. Get that offset wrong in either direction —
// forget it, or add it to a kernel that already computes an absolute address —
// and the bands land on top of each other or past the end. This is exactly the
// class of bug the full-range tests cannot see, so the exhaustive split sweep
// matters most here.
fn nn_se_conv2d(u32 in_h, u32 in_w, u32 in_c, u32 out_c,
                u32 kh, u32 kw, u32 sh, u32 sw, u32 ph, u32 pw) {
    u32 ip = nn_se_in
    u32 wp = nn_se_wt
    u32 a = nn_se_a
    u32 b = nn_se_b
    u32 bp = nn_se_bias
    u32 mp = nn_se_mult
    u32 sp = nn_se_shift

    u32 out_h = nn_out_dim(in_h, kh, sh, ph)
    u32 out_w = nn_out_dim(in_w, kw, sw, pw)
    u32 obytes = (out_h * out_w) * out_c

    // Declare the footprint before writing a single byte.
    nn_se_need(nn_se_cap, (in_h * in_w) * in_c, 0)          // nn_se_in
    nn_se_need(nn_se_cap, ((out_c * kh) * kw) * in_c, 1)    // nn_se_wt
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 2)          // nn_se_a
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 3)          // nn_se_b
    nn_se_need(nn_se_quant, out_c, 4)                       // bias/mult/shift

    nn_se_fill(ip, (in_h * in_w) * in_c)
    nn_se_fill(wp, ((out_c * kh) * kw) * in_c)
    nn_se_fill_quant(out_c)
    i32 izp = 0 - 3
    i32 ozp = 11
    i32 lo = 0 - 128

    nn_se_poison(a, obytes)
    nn_conv2d_int8(ip, in_h, in_w, in_c, izp, wp, kh, kw, bp, mp, sp, 1,
                   a, out_c, ozp, sh, sw, ph, pw, lo, 127)

    u32 k = 0
    while k <= out_h {
        nn_se_poison(b, obytes)
        u32 k2 = nn_se_pk(k, out_h)
        nn_conv2d_int8_rows(ip, in_h, in_w, in_c, izp, wp, kh, kw, bp, mp, sp, 1,
                            b, out_c, ozp, sh, sw, ph, pw, lo, 127, 0, k)
        nn_conv2d_int8_rows(ip, in_h, in_w, in_c, izp, wp, kh, kw, bp, mp, sp, 1,
                            b, out_c, ozp, sh, sw, ph, pw, lo, 127, k2, out_h)
        nn_se_cmp(obytes, k)
        k = k + 1
    }
}

// nn_depthwise_conv2d_int8 addresses its output absolutely from `oy` and works
// out the row stride itself from in_c * depth_mult, so bounding the loop is its
// whole change. A spurious out_p offset would show up here as a mismatch on
// every k except 0 and out_h.
fn nn_se_dwconv(u32 in_h, u32 in_w, u32 in_c, u32 dm,
                u32 kh, u32 kw, u32 sh, u32 sw, u32 ph, u32 pw) {
    u32 ip = nn_se_in
    u32 wp = nn_se_wt
    u32 a = nn_se_a
    u32 b = nn_se_b
    u32 bp = nn_se_bias
    u32 mp = nn_se_mult
    u32 sp = nn_se_shift
    u32 out_c = in_c * dm

    u32 out_h = nn_out_dim(in_h, kh, sh, ph)
    u32 out_w = nn_out_dim(in_w, kw, sw, pw)
    u32 obytes = (out_h * out_w) * out_c

    nn_se_need(nn_se_cap, (in_h * in_w) * in_c, 0)          // nn_se_in
    nn_se_need(nn_se_cap, (kh * kw) * out_c, 1)             // nn_se_wt
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 2)          // nn_se_a
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 3)          // nn_se_b
    nn_se_need(nn_se_quant, out_c, 4)                       // bias/mult/shift

    nn_se_fill(ip, (in_h * in_w) * in_c)
    nn_se_fill(wp, (kh * kw) * out_c)
    nn_se_fill_quant(out_c)
    i32 izp = 0 - 12
    i32 ozp = 0 - 2
    i32 lo = 0 - 128

    nn_se_poison(a, obytes)
    nn_depthwise_conv2d_int8(ip, in_h, in_w, in_c, izp, wp, kh, kw, bp, mp, sp, 1,
                             a, ozp, sh, sw, ph, pw, dm, lo, 127)

    u32 k = 0
    while k <= out_h {
        nn_se_poison(b, obytes)
        u32 k2 = nn_se_pk(k, out_h)
        nn_depthwise_conv2d_int8_rows(ip, in_h, in_w, in_c, izp, wp, kh, kw,
                                      bp, mp, sp, 1, b, ozp, sh, sw, ph, pw,
                                      dm, lo, 127, 0, k)
        nn_depthwise_conv2d_int8_rows(ip, in_h, in_w, in_c, izp, wp, kh, kw,
                                      bp, mp, sp, 1, b, ozp, sh, sw, ph, pw,
                                      dm, lo, 127, k2, out_h)
        nn_se_cmp(obytes, k)
        k = k + 1
    }
}

fn nn_se_maxpool(u32 in_h, u32 in_w, u32 in_c,
                 u32 kh, u32 kw, u32 sh, u32 sw, u32 ph, u32 pw) {
    u32 ip = nn_se_in
    u32 a = nn_se_a
    u32 b = nn_se_b
    u32 out_h = nn_out_dim(in_h, kh, sh, ph)
    u32 out_w = nn_out_dim(in_w, kw, sw, pw)
    u32 obytes = (out_h * out_w) * in_c
    nn_se_need(nn_se_cap, (in_h * in_w) * in_c, 0)
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 2)
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 3)
    nn_se_fill(ip, (in_h * in_w) * in_c)

    nn_se_poison(a, obytes)
    nn_maxpool_int8(ip, in_h, in_w, in_c, a, kh, kw, sh, sw, ph, pw, 0 - 128, 127)

    u32 k = 0
    while k <= out_h {
        nn_se_poison(b, obytes)
        u32 k2 = nn_se_pk(k, out_h)
        nn_maxpool_int8_rows(ip, in_h, in_w, in_c, b, kh, kw, sh, sw, ph, pw,
                             0 - 128, 127, 0, k)
        nn_maxpool_int8_rows(ip, in_h, in_w, in_c, b, kh, kw, sh, sw, ph, pw,
                             0 - 128, 127, k2, out_h)
        nn_se_cmp(obytes, k)
        k = k + 1
    }
}

fn nn_se_avgpool(u32 in_h, u32 in_w, u32 in_c,
                 u32 kh, u32 kw, u32 sh, u32 sw, u32 ph, u32 pw) {
    u32 ip = nn_se_in
    u32 a = nn_se_a
    u32 b = nn_se_b
    u32 out_h = nn_out_dim(in_h, kh, sh, ph)
    u32 out_w = nn_out_dim(in_w, kw, sw, pw)
    u32 obytes = (out_h * out_w) * in_c
    nn_se_need(nn_se_cap, (in_h * in_w) * in_c, 0)
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 2)
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 3)
    nn_se_fill(ip, (in_h * in_w) * in_c)

    nn_se_poison(a, obytes)
    nn_avgpool_int8(ip, in_h, in_w, in_c, a, kh, kw, sh, sw, ph, pw, 0 - 128, 127)

    u32 k = 0
    while k <= out_h {
        nn_se_poison(b, obytes)
        u32 k2 = nn_se_pk(k, out_h)
        nn_avgpool_int8_rows(ip, in_h, in_w, in_c, b, kh, kw, sh, sw, ph, pw,
                             0 - 128, 127, 0, k)
        nn_avgpool_int8_rows(ip, in_h, in_w, in_c, b, kh, kw, sh, sw, ph, pw,
                             0 - 128, 127, k2, out_h)
        nn_se_cmp(obytes, k)
        k = k + 1
    }
}

fn nn_se_resize(u32 in_h, u32 in_w, u32 in_c, u32 scale_h, u32 scale_w) {
    u32 ip = nn_se_in
    u32 a = nn_se_a
    u32 b = nn_se_b
    u32 out_h = in_h * scale_h
    u32 out_w = in_w * scale_w
    u32 obytes = (out_h * out_w) * in_c
    nn_se_need(nn_se_cap, (in_h * in_w) * in_c, 0)
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 2)
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 3)
    nn_se_fill(ip, (in_h * in_w) * in_c)

    nn_se_poison(a, obytes)
    nn_resize_nearest_int8(ip, in_h, in_w, in_c, a, scale_h, scale_w)

    u32 k = 0
    while k <= out_h {
        nn_se_poison(b, obytes)
        u32 k2 = nn_se_pk(k, out_h)
        nn_resize_nearest_int8_rows(ip, in_h, in_w, in_c, b, scale_h, scale_w, 0, k)
        nn_resize_nearest_int8_rows(ip, in_h, in_w, in_c, b, scale_h, scale_w, k2, out_h)
        nn_se_cmp(obytes, k)
        k = k + 1
    }
}


// ---------------------------------------------------------------------------
// Elementwise kernels (Task 3) — split on ELEMENT count
// ---------------------------------------------------------------------------

fn nn_se_relu(u32 n) {
    u32 ip = nn_se_in
    u32 a = nn_se_a
    u32 b = nn_se_b
    nn_se_need(nn_se_cap, n, 0)
    nn_se_need(nn_se_cap, n + nn_se_guard, 2)
    nn_se_need(nn_se_cap, n + nn_se_guard, 3)
    nn_se_fill(ip, n)
    i32 zp = 0 - 7

    // ReLU is in place, so each side needs its own fresh copy of the input.
    // Poison first so the trailing guard band is armed on this side too.
    nn_se_poison(a, n)
    nn_copy_i8(a, ip, n)
    nn_relu_int8(a, n, zp)

    u32 k = 0
    while k <= n {
        nn_se_poison(b, n)
        nn_copy_i8(b, ip, n)
        u32 k2 = nn_se_pk(k, n)
        nn_relu_int8_range(b, n, zp, 0, k)
        nn_relu_int8_range(b, n, zp, k2, n - k2)
        nn_se_cmp(n, k)
        k = k + 1
    }
}

fn nn_se_copy(u32 n) {
    u32 ip = nn_se_in
    u32 a = nn_se_a
    u32 b = nn_se_b
    nn_se_need(nn_se_cap, n, 0)
    nn_se_need(nn_se_cap, n + nn_se_guard, 2)
    nn_se_need(nn_se_cap, n + nn_se_guard, 3)
    nn_se_fill(ip, n)

    nn_se_poison(a, n)
    nn_copy_i8(a, ip, n)

    u32 k = 0
    while k <= n {
        nn_se_poison(b, n)
        u32 k2 = nn_se_pk(k, n)
        nn_copy_i8_range(b, ip, n, 0, k)
        nn_copy_i8_range(b, ip, n, k2, n - k2)
        nn_se_cmp(n, k)
        k = k + 1
    }
}

fn nn_se_add(u32 n) {
    u32 ip = nn_se_in
    u32 ip2 = nn_se_in2
    u32 a = nn_se_a
    u32 b = nn_se_b
    nn_se_need(nn_se_cap, n, 0)
    nn_se_need(nn_se_cap, n + nn_se_guard, 2)
    nn_se_need(nn_se_cap, n + nn_se_guard, 3)
    nn_se_need(nn_se_cap, n, 5)
    nn_se_fill(ip, n)
    nn_se_fill(ip2, n)
    i32 azp = 0 - 3
    i32 bzp = 5
    i32 ozp = 0 - 11
    i32 am = 0x50000000
    i32 bm = 0x6A000000
    i32 om = 0x40000000
    i32 ash = 0 - 3
    i32 bsh = 0 - 4
    i32 osh = 0 - 20

    nn_se_poison(a, n)
    nn_add_int8(ip, azp, am, ash, ip2, bzp, bm, bsh, a, ozp, om, osh,
                n, 20, 0 - 128, 127)

    u32 k = 0
    while k <= n {
        nn_se_poison(b, n)
        u32 k2 = nn_se_pk(k, n)
        nn_add_int8_range(ip, azp, am, ash, ip2, bzp, bm, bsh, b, ozp, om, osh,
                          n, 20, 0 - 128, 127, 0, k)
        nn_add_int8_range(ip, azp, am, ash, ip2, bzp, bm, bsh, b, ozp, om, osh,
                          n, 20, 0 - 128, 127, k2, n - k2)
        nn_se_cmp(n, k)
        k = k + 1
    }
}

fn nn_se_sigmoid(u32 n) {
    u32 ip = nn_se_in
    u32 a = nn_se_a
    u32 b = nn_se_b
    u32 lp = nn_se_lut
    nn_se_need(nn_se_cap, n, 0)
    nn_se_need(nn_se_cap, n + nn_se_guard, 2)
    nn_se_need(nn_se_cap, n + nn_se_guard, 3)
    nn_se_fill(ip, n)
    // A non-trivial, non-identity table so a dropped element cannot coincide
    // with the value it replaced.
    u32 t = 0
    while t < 256 {
        store8(lp + t, ((t * 7) + 13) & 0xFF)
        t = t + 1
    }

    nn_se_poison(a, n)
    nn_sigmoid_lut_int8(ip, n, lp, a)

    u32 k = 0
    while k <= n {
        nn_se_poison(b, n)
        u32 k2 = nn_se_pk(k, n)
        nn_sigmoid_lut_int8_range(ip, n, lp, b, 0, k)
        nn_sigmoid_lut_int8_range(ip, n, lp, b, k2, n - k2)
        nn_se_cmp(n, k)
        k = k + 1
    }
}


// ---------------------------------------------------------------------------
// The MODEL-RUNNER dispatcher — std/nn_model.mlr's nn_model_exec_range
// ---------------------------------------------------------------------------
// Everything above proves the KERNELS partition correctly. It says nothing
// about the layer of code that decides WHICH kernel to call and pulls its
// twenty-odd arguments out of a 160-byte binary record at fixed byte offsets.
// That layer is new, it is duplicated (nn_model_exec and nn_model_exec_range
// each decode the same record independently), and its characteristic failure
// is a single wrong offset — say reading out_zp where act_min belongs — which
// produces confidently wrong numbers, not a crash. On silicon it would look
// exactly like a cross-core data race.
//
// So the same identity is asserted one level up, against the dispatcher:
//
//     nn_model_exec(r)  ==  nn_model_exec_range(r, 0, k) then (r, k, n)
//
// for every split point k, over a hand-built record for each of the four
// opt-in opcodes. Because the full-range side goes through nn_model_exec and
// the split side through nn_model_exec_range, a divergence between the two
// decoders is caught even at k = 0 and k = n, where the kernels themselves are
// not being split at all.
//
// Arena layout (byte offsets into nn_se_ar):
//        0  input A
//      256  input B      (ADD only)
//      512  the output tensor, plus nn_se_guard bytes of poison behind it
// nn_se_disp_grab copies output+guard into nn_se_a / nn_se_b so nn_se_cmp's
// existing overrun check sees the ARENA's guard band, not a private one.

fn nn_se_rec_zero() {
    u32 r = nn_se_rec
    u32 i = 0
    while i < 160 {
        store8(r + i, 0)
        i = i + 1
    }
}

fn nn_se_rec_set(u32 off, u32 v) {
    store32(nn_se_rec + off, v)
}

fn nn_se_rec_seti(u32 off, i32 v) {
    nn_store_i32(nn_se_rec + off, v)
}

fn nn_se_bytes(u32 dst, u32 src, u32 n) {
    u32 i = 0
    while i < n {
        store8(dst + i, load8(src + i))
        i = i + 1
    }
}

fn nn_se_fillbyte(u32 dst, u32 n, u32 v) {
    u32 i = 0
    while i < n {
        store8(dst + i, v)
        i = i + 1
    }
}

// Reset the arena to its pre-run state. `inplace` means the layer's output
// aliases its input (op 4 as the memory planner usually emits it), in which
// case the output region must hold the pristine INPUT rather than poison —
// there is nowhere else for it to come from.
fn nn_se_disp_prep(u32 n, u32 inplace) {
    u32 ar = nn_se_ar
    u32 op = ar + nn_se_ar_out
    nn_se_bytes(ar, nn_se_in, n)
    nn_se_bytes(ar + 256, nn_se_in2, n)
    if inplace != 0 {
        nn_se_bytes(op, nn_se_in, n)
    } else {
        nn_se_fillbyte(op, n, 0x5A)
    }
    nn_se_fillbyte(op + n, nn_se_guard, 0x5A)
}

fn nn_se_disp_grab(u32 dst, u32 n) {
    nn_se_fillbyte(dst, n + nn_se_guard, 0x5A)
    nn_se_bytes(dst, nn_se_ar + nn_se_ar_out, n + nn_se_guard)
}

// ---- spatial dispatch: the arena, the band space, and the extent check -----
//
// The spatial cases below reuse the same fake arena, but their input and output
// are DIFFERENT sizes, so they need their own prep. Input lands at arena+0 and
// the output tensor at arena+nn_se_ar_out with nn_se_guard poison behind it,
// exactly as the elementwise cases arrange it.
//
// `blob` is passed as 0 and every blob offset in the record is the ABSOLUTE
// address of a static. nn_model_blob_ptr(0, off) == off, so the weights, bias
// and quant tables resolve to nn_se_wt / nn_se_bias / nn_se_mult / nn_se_shift
// without having to pack a contiguous blob. (0xFFFFFFFF is the only offset with
// a special meaning and no static can live there.)
fn nn_se_disp_sp_prep(u32 ibytes, u32 obytes) {
    u32 ar = nn_se_ar
    nn_se_bytes(ar, nn_se_in, ibytes)
    nn_se_fillbyte(ar + nn_se_ar_out, obytes + nn_se_guard, 0x5A)
}

// Sweep every ROW split point for the spatial record nn_se_rec currently holds.
//
// The first thing it does is check that nn_model_split_n() — which is what a
// caller uses to decide where to cut, and which derives out_h from the record's
// own fields — agrees with the out_h this case computed the way the kernel's
// full-range forwarder does. That is the one failure mode a band sweep alone
// cannot see: if BOTH the sweep bound and the dispatcher used a wrong out_h,
// every split would still agree with a full range that was equally truncated.
fn nn_se_dispatch_sp(u32 ibytes, u32 obytes, u32 out_h) {
    nn_se_need(nn_se_cap, ibytes, 0)                               // nn_se_in
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 2)                 // nn_se_a
    nn_se_need(nn_se_cap, obytes + nn_se_guard, 3)                 // nn_se_b
    nn_se_need(nn_se_arena, nn_se_ar_out + obytes + nn_se_guard, 6) // nn_se_ar

    u32 r = nn_se_rec
    u32 ar = nn_se_ar

    nn_se_checks = nn_se_checks + 1
    u32 sn = nn_model_split_n(r)
    if sn != out_h {
        nn_se_fails = nn_se_fails + 1
        print_str("  EXTENT op=")
        nn_se_emit_u32(load32(r))
        print_str(": nn_model_split_n=")
        nn_se_emit_u32(sn)
        print_str(" but the kernel's out_h=")
        nn_se_emit_u32(out_h)
        print_str("\n")
        return
    }
    if nn_model_op_rowsplit(load32(r)) == 0 {
        nn_se_fails = nn_se_fails + 1
        print_str("  EXTENT op=")
        nn_se_emit_u32(load32(r))
        print_str(": spatial case is not on the rowsplit list\n")
        return
    }

    nn_se_disp_sp_prep(ibytes, obytes)
    nn_model_exec(r, ar, 0)
    nn_se_disp_grab(nn_se_a, obytes)

    u32 k = 0
    while k <= out_h {
        nn_se_disp_sp_prep(ibytes, obytes)
        u32 k2 = nn_se_pk(k, out_h)
        nn_model_exec_range(r, ar, 0, 0, k)
        nn_model_exec_range(r, ar, 0, k2, out_h)
        nn_se_disp_grab(nn_se_b, obytes)
        nn_se_cmp(obytes, k)
        k = k + 1
    }
}

// Sweep every split point for whatever record nn_se_rec currently holds.
fn nn_se_dispatch(u32 n, u32 inplace) {
    nn_se_need(nn_se_cap, n, 0)                                    // nn_se_in
    nn_se_need(nn_se_cap, n, 5)                                    // nn_se_in2
    nn_se_need(nn_se_cap, n + nn_se_guard, 2)                      // nn_se_a
    nn_se_need(nn_se_cap, n + nn_se_guard, 3)                      // nn_se_b
    nn_se_need(nn_se_arena, nn_se_ar_out + n + nn_se_guard, 6)     // nn_se_ar

    u32 r = nn_se_rec
    u32 ar = nn_se_ar
    u32 blob = nn_se_lut

    nn_se_disp_prep(n, inplace)
    nn_model_exec(r, ar, blob)
    nn_se_disp_grab(nn_se_a, n)

    u32 k = 0
    while k <= n {
        nn_se_disp_prep(n, inplace)
        u32 k2 = nn_se_pk(k, n)
        nn_model_exec_range(r, ar, blob, 0, k)
        nn_model_exec_range(r, ar, blob, k2, n)
        nn_se_disp_grab(nn_se_b, n)
        nn_se_cmp(n, k)
        k = k + 1
    }
}

// op 4 RELU. `inplace` selects the two shapes the planner can emit: output
// aliased onto the input (the common case), and a distinct output, where
// nn_model_exec_range has to band the COPY as well as the ReLU.
fn nn_se_disp_relu(u32 n, u32 inplace) {
    nn_se_fill(nn_se_in, n)
    nn_se_rec_zero()
    nn_se_rec_set(0, 4)
    if inplace != 0 {
        nn_se_rec_set(4, nn_se_ar_out)
    } else {
        nn_se_rec_set(4, 0)
    }
    nn_se_rec_set(12, nn_se_ar_out)
    nn_se_rec_seti(88, 0 - 7)               // in_zp
    nn_se_rec_set(104, n)                   // n_elem
    nn_se_dispatch(n, inplace)
}

// op 9 COPY.
fn nn_se_disp_copy(u32 n) {
    nn_se_fill(nn_se_in, n)
    nn_se_rec_zero()
    nn_se_rec_set(0, 9)
    nn_se_rec_set(4, 0)
    nn_se_rec_set(12, nn_se_ar_out)
    nn_se_rec_set(104, n)
    nn_se_dispatch(n, 0)
}

// op 8 SIGMOID_LUT. The blob base is nn_se_lut and lut_off is 0, so
// nn_model_blob_ptr resolves to the table below. A non-identity table means a
// dropped element cannot coincide with the value it replaced.
fn nn_se_disp_sigmoid(u32 n) {
    nn_se_fill(nn_se_in, n)
    u32 lp = nn_se_lut
    u32 t = 0
    while t < 256 {
        store8(lp + t, ((t * 7) + 13) & 0xFF)
        t = t + 1
    }
    nn_se_rec_zero()
    nn_se_rec_set(0, 8)
    nn_se_rec_set(4, 0)
    nn_se_rec_set(12, nn_se_ar_out)
    nn_se_rec_set(104, n)
    nn_se_rec_set(140, 0)                   // lut_off
    nn_se_dispatch(n, 0)
}

// op 6 ADD. Sixteen fields come out of the record here, which is why this case
// exists: it is by far the easiest of the four to mis-decode, and the two
// decoders have to agree on every one of them.
fn nn_se_disp_add(u32 n) {
    nn_se_fill(nn_se_in, n)
    nn_se_fill(nn_se_in2, n)
    nn_se_rec_zero()
    nn_se_rec_set(0, 6)
    nn_se_rec_set(4, 0)                     // in0_off
    nn_se_rec_set(8, 256)                   // in1_off
    nn_se_rec_set(12, nn_se_ar_out)         // out_off
    nn_se_rec_seti(88, 0 - 3)               // in_zp   (A)
    nn_se_rec_seti(92, 0 - 11)              // out_zp
    nn_se_rec_seti(96, 0 - 128)             // act_min
    nn_se_rec_seti(100, 127)                // act_max
    nn_se_rec_set(104, n)                   // n_elem
    nn_se_rec_seti(108, 5)                  // in1_zp  (B)
    nn_se_rec_seti(112, 0x50000000)         // a_mult
    nn_se_rec_seti(116, 0 - 3)              // a_shift
    nn_se_rec_seti(120, 0x6A000000)         // b_mult
    nn_se_rec_seti(124, 0 - 4)              // b_shift
    nn_se_rec_seti(128, 0x40000000)         // o_mult
    nn_se_rec_seti(132, 0 - 20)             // o_shift
    nn_se_rec_set(136, 20)                  // left_shift
    nn_se_dispatch(n, 0)
}

// --- the six SPATIAL opcodes, through the dispatcher ------------------------
// Same shape as the four above: build a record, hand it to the sweeper. The
// field offsets written here are the ones nn_model_exec() READS, so a case that
// wrote the wrong offset would make BOTH sides of the comparison wrong in the
// same way and prove nothing — which is why each of these is also mirrored by a
// kernel-level case above using the same shapes, and why the extent check in
// nn_se_dispatch_sp exists.

// op 1 CONV2D.
fn nn_se_disp_conv(u32 in_h, u32 in_w, u32 in_c, u32 out_c,
                   u32 kh, u32 kw, u32 sh, u32 sw, u32 ph, u32 pw) {
    u32 out_h = nn_out_dim(in_h, kh, sh, ph)
    u32 out_w = nn_out_dim(in_w, kw, sw, pw)
    u32 ibytes = (in_h * in_w) * in_c
    u32 obytes = (out_h * out_w) * out_c
    nn_se_need(nn_se_cap, ((out_c * kh) * kw) * in_c, 1)    // nn_se_wt
    nn_se_need(nn_se_quant, out_c, 4)                       // bias/mult/shift
    nn_se_fill(nn_se_in, ibytes)
    nn_se_fill(nn_se_wt, ((out_c * kh) * kw) * in_c)
    nn_se_fill_quant(out_c)

    nn_se_rec_zero()
    nn_se_rec_set(0, 1)
    nn_se_rec_set(4, 0)                     // in0_off
    nn_se_rec_set(12, nn_se_ar_out)         // out_off
    nn_se_rec_set(16, in_h)  nn_se_rec_set(20, in_w)  nn_se_rec_set(24, in_c)
    nn_se_rec_set(36, out_c)
    nn_se_rec_set(40, kh)    nn_se_rec_set(44, kw)
    nn_se_rec_set(48, sh)    nn_se_rec_set(52, sw)
    nn_se_rec_set(56, ph)    nn_se_rec_set(60, pw)
    nn_se_rec_set(68, 1)                    // q_stride: per-channel
    nn_se_rec_set(72, nn_se_wt)             // w_off    (blob == 0, see above)
    nn_se_rec_set(76, nn_se_bias)
    nn_se_rec_set(80, nn_se_mult)
    nn_se_rec_set(84, nn_se_shift)
    nn_se_rec_seti(88, 0 - 3)               // in_zp
    nn_se_rec_seti(92, 11)                  // out_zp
    nn_se_rec_seti(96, 0 - 128)             // act_min
    nn_se_rec_seti(100, 127)                // act_max
    nn_se_rec_set(104, obytes)
    nn_se_dispatch_sp(ibytes, obytes, out_h)
}

// op 3 POINTWISE. Deliberately built as its OWN opcode rather than as a 1x1
// conv2d: the whole claim is that the dispatcher can band a layer whose record
// carries no kh/kw/stride/pad at all, by substituting the five constants
// nn_pointwise_conv_int8 substitutes. Those fields are left ZERO here, so a
// dispatcher that read them instead of hardcoding 1/1/1/1/0 would produce
// out_dim(in_h, 0, 0, 0) and fail loudly rather than coincidentally work.
fn nn_se_disp_pointwise(u32 in_h, u32 in_w, u32 in_c, u32 out_c) {
    u32 ibytes = (in_h * in_w) * in_c
    u32 obytes = (in_h * in_w) * out_c
    nn_se_need(nn_se_cap, out_c * in_c, 1)
    nn_se_need(nn_se_quant, out_c, 4)
    nn_se_fill(nn_se_in, ibytes)
    nn_se_fill(nn_se_wt, out_c * in_c)
    nn_se_fill_quant(out_c)

    nn_se_rec_zero()
    nn_se_rec_set(0, 3)
    nn_se_rec_set(4, 0)
    nn_se_rec_set(12, nn_se_ar_out)
    nn_se_rec_set(16, in_h)  nn_se_rec_set(20, in_w)  nn_se_rec_set(24, in_c)
    nn_se_rec_set(36, out_c)
    nn_se_rec_set(68, 1)
    nn_se_rec_set(72, nn_se_wt)
    nn_se_rec_set(76, nn_se_bias)
    nn_se_rec_set(80, nn_se_mult)
    nn_se_rec_set(84, nn_se_shift)
    nn_se_rec_seti(88, 0 - 6)
    nn_se_rec_seti(92, 4)
    nn_se_rec_seti(96, 0 - 128)
    nn_se_rec_seti(100, 127)
    nn_se_rec_set(104, obytes)
    nn_se_dispatch_sp(ibytes, obytes, in_h)
}

// op 2 DEPTHWISE.
fn nn_se_disp_dw(u32 in_h, u32 in_w, u32 in_c, u32 dm,
                 u32 kh, u32 kw, u32 sh, u32 sw, u32 ph, u32 pw) {
    u32 out_c = in_c * dm
    u32 out_h = nn_out_dim(in_h, kh, sh, ph)
    u32 out_w = nn_out_dim(in_w, kw, sw, pw)
    u32 ibytes = (in_h * in_w) * in_c
    u32 obytes = (out_h * out_w) * out_c
    nn_se_need(nn_se_cap, (kh * kw) * out_c, 1)
    nn_se_need(nn_se_quant, out_c, 4)
    nn_se_fill(nn_se_in, ibytes)
    nn_se_fill(nn_se_wt, (kh * kw) * out_c)
    nn_se_fill_quant(out_c)

    nn_se_rec_zero()
    nn_se_rec_set(0, 2)
    nn_se_rec_set(4, 0)
    nn_se_rec_set(12, nn_se_ar_out)
    nn_se_rec_set(16, in_h)  nn_se_rec_set(20, in_w)  nn_se_rec_set(24, in_c)
    nn_se_rec_set(36, out_c)
    nn_se_rec_set(40, kh)    nn_se_rec_set(44, kw)
    nn_se_rec_set(48, sh)    nn_se_rec_set(52, sw)
    nn_se_rec_set(56, ph)    nn_se_rec_set(60, pw)
    nn_se_rec_set(64, dm)                   // depth_mult
    nn_se_rec_set(68, 1)
    nn_se_rec_set(72, nn_se_wt)
    nn_se_rec_set(76, nn_se_bias)
    nn_se_rec_set(80, nn_se_mult)
    nn_se_rec_set(84, nn_se_shift)
    nn_se_rec_seti(88, 0 - 12)
    nn_se_rec_seti(92, 0 - 2)
    nn_se_rec_seti(96, 0 - 128)
    nn_se_rec_seti(100, 127)
    nn_se_rec_set(104, obytes)
    nn_se_dispatch_sp(ibytes, obytes, out_h)
}

// ops 5 MAXPOOL and 10 AVGPOOL — identical record shape, so one builder.
fn nn_se_disp_pool(u32 op, u32 in_h, u32 in_w, u32 in_c,
                   u32 kh, u32 kw, u32 sh, u32 sw, u32 ph, u32 pw) {
    u32 out_h = nn_out_dim(in_h, kh, sh, ph)
    u32 out_w = nn_out_dim(in_w, kw, sw, pw)
    u32 ibytes = (in_h * in_w) * in_c
    u32 obytes = (out_h * out_w) * in_c
    nn_se_fill(nn_se_in, ibytes)

    nn_se_rec_zero()
    nn_se_rec_set(0, op)
    nn_se_rec_set(4, 0)
    nn_se_rec_set(12, nn_se_ar_out)
    nn_se_rec_set(16, in_h)  nn_se_rec_set(20, in_w)  nn_se_rec_set(24, in_c)
    nn_se_rec_set(40, kh)    nn_se_rec_set(44, kw)
    nn_se_rec_set(48, sh)    nn_se_rec_set(52, sw)
    nn_se_rec_set(56, ph)    nn_se_rec_set(60, pw)
    nn_se_rec_seti(96, 0 - 128)
    nn_se_rec_seti(100, 127)
    nn_se_rec_set(104, obytes)
    nn_se_dispatch_sp(ibytes, obytes, out_h)
}

// op 7 RESIZE_NN. scale_h/scale_w live at +48/+52 — the SAME two words that
// carry stride_h/stride_w for every other spatial op, which is precisely why
// nn_model_out_h has to special-case this opcode instead of calling
// nn_out_dim() on those fields.
fn nn_se_disp_resize(u32 in_h, u32 in_w, u32 in_c, u32 scale_h, u32 scale_w) {
    u32 out_h = in_h * scale_h
    u32 out_w = in_w * scale_w
    u32 ibytes = (in_h * in_w) * in_c
    u32 obytes = (out_h * out_w) * in_c
    nn_se_fill(nn_se_in, ibytes)

    nn_se_rec_zero()
    nn_se_rec_set(0, 7)
    nn_se_rec_set(4, 0)
    nn_se_rec_set(12, nn_se_ar_out)
    nn_se_rec_set(16, in_h)  nn_se_rec_set(20, in_w)  nn_se_rec_set(24, in_c)
    nn_se_rec_set(48, scale_h)
    nn_se_rec_set(52, scale_w)
    nn_se_rec_set(104, obytes)
    nn_se_dispatch_sp(ibytes, obytes, out_h)
}


// ---------------------------------------------------------------------------
// Cases
// ---------------------------------------------------------------------------

fn nn_se_run() {
    nn_se_seed = 12345

    // --- spatial: split on output rows -------------------------------------
    // out_h is noted per case; several are ODD on purpose.
    print_str("conv2d\n")
    //             in_h in_w in_c out_c  kh kw  sh sw  ph pw
    nn_se_conv2d(     5,   5,   2,    3,  3, 3,  1, 1,  1, 1)   // out_h 5 (odd)
    nn_se_conv2d(     6,   6,   2,    2,  3, 3,  2, 2,  0, 0)   // out_h 2, unpadded
    nn_se_conv2d(     7,   4,   3,    4,  3, 3,  2, 1,  1, 1)   // out_h 4, strided+padded
    nn_se_conv2d(     9,   3,   1,    5,  3, 3,  1, 1,  1, 1)   // out_h 9 (odd)
    nn_se_conv2d(     3,   3,   2,    2,  3, 3,  1, 1,  2, 2)   // out_h 5 (odd), pad > k/2
    nn_se_conv2d(     4,   4,   2,    3,  4, 4,  4, 4,  0, 0)   // out_h 1, whole-window
    nn_se_conv2d(     5,   5,   3,    4,  1, 1,  1, 1,  0, 0)   // out_h 5 (odd), 1x1 = pointwise

    print_str("depthwise\n")
    //             in_h in_w in_c  dm  kh kw  sh sw  ph pw
    nn_se_dwconv(     5,   5,   3,  1,  3, 3,  1, 1,  1, 1)     // out_h 5 (odd)
    nn_se_dwconv(     4,   4,   2,  2,  3, 3,  2, 2,  1, 1)     // out_h 2, depth_mult 2
    nn_se_dwconv(     7,   3,   2,  1,  3, 3,  2, 1,  1, 1)     // out_h 4, strided
    nn_se_dwconv(     9,   4,   1,  3,  3, 3,  1, 1,  1, 1)     // out_h 9 (odd), depth_mult 3
    nn_se_dwconv(     3,   3,   4,  1,  3, 3,  1, 1,  2, 2)     // out_h 5 (odd), pad > k/2
    nn_se_dwconv(     4,   4,   2,  1,  4, 4,  4, 4,  0, 0)     // out_h 1, whole-window

    print_str("maxpool\n")
    nn_se_maxpool(7, 5, 2, 2, 2, 2, 2, 0, 0)      // out_h 3 (odd)
    nn_se_maxpool(7, 7, 3, 3, 3, 2, 2, 1, 1)      // out_h 4, padded
    nn_se_maxpool(9, 4, 1, 3, 3, 1, 1, 1, 1)      // out_h 9 (odd), stride 1
    nn_se_maxpool(5, 5, 2, 3, 3, 2, 2, 1, 1)      // out_h 3 (odd), padded
    nn_se_maxpool(4, 4, 2, 4, 4, 4, 4, 0, 0)      // out_h 1, whole-window

    print_str("avgpool\n")
    nn_se_avgpool(7, 5, 2, 2, 2, 2, 2, 0, 0)
    nn_se_avgpool(7, 7, 3, 3, 3, 2, 2, 1, 1)
    nn_se_avgpool(9, 4, 1, 3, 3, 1, 1, 1, 1)
    nn_se_avgpool(5, 5, 2, 3, 3, 2, 2, 1, 1)
    nn_se_avgpool(4, 4, 2, 4, 4, 4, 4, 0, 0)

    print_str("resize_nearest\n")
    nn_se_resize(3, 2, 2, 3, 2)                   // out_h 9 (odd)
    nn_se_resize(2, 3, 1, 2, 1)                   // out_h 4
    nn_se_resize(5, 2, 3, 1, 2)                   // out_h 5 (odd), scale_h 1
    nn_se_resize(1, 1, 4, 7, 7)                   // out_h 7 (odd), degenerate

    // --- elementwise: split on element count (Task 3) -----------------------
    print_str("elementwise\n")
    nn_se_relu(37)                                // odd, prime
    nn_se_relu(16)
    nn_se_relu(1)
    nn_se_copy(37)
    nn_se_copy(16)
    nn_se_copy(1)
    nn_se_add(37)
    nn_se_add(16)
    nn_se_add(1)
    nn_se_sigmoid(37)
    nn_se_sigmoid(16)
    nn_se_sigmoid(1)

    // --- the model runner's banded dispatcher (Task 5) ----------------------
    print_str("dispatch\n")
    nn_se_disp_relu(37, 1)      nn_se_disp_relu(16, 1)      nn_se_disp_relu(1, 1)
    nn_se_disp_relu(37, 0)      nn_se_disp_relu(16, 0)      nn_se_disp_relu(1, 0)
    nn_se_disp_copy(37)         nn_se_disp_copy(16)         nn_se_disp_copy(1)
    nn_se_disp_sigmoid(37)      nn_se_disp_sigmoid(16)      nn_se_disp_sigmoid(1)
    nn_se_disp_add(37)          nn_se_disp_add(16)          nn_se_disp_add(1)

    // --- the same dispatcher on the six SPATIAL opcodes (Task 6) ------------
    // Shapes mirror the kernel-level cases above, including the odd out_h and
    // the degenerate out_h == 1 (which no row split can cut, and which must
    // still be byte-identical rather than merely "not crash").
    print_str("dispatch-spatial\n")
    //               in_h in_w in_c out_c  kh kw  sh sw  ph pw
    nn_se_disp_conv(    5,   5,   2,    3,  3, 3,  1, 1,  1, 1)   // out_h 5 (odd)
    nn_se_disp_conv(    6,   6,   2,    2,  3, 3,  2, 2,  0, 0)   // out_h 2
    nn_se_disp_conv(    7,   4,   3,    4,  3, 3,  2, 1,  1, 1)   // out_h 4
    nn_se_disp_conv(    9,   3,   1,    5,  3, 3,  1, 1,  1, 1)   // out_h 9 (odd)
    nn_se_disp_conv(    3,   3,   2,    2,  3, 3,  1, 1,  2, 2)   // out_h 5, pad > k/2
    nn_se_disp_conv(    4,   4,   2,    3,  4, 4,  4, 4,  0, 0)   // out_h 1
    // ph != pw and kh != kw, so a dispatcher that swapped either pair — the
    // easiest possible mis-decode, since the fields are adjacent — diverges.
    nn_se_disp_conv(    5,   5,   2,    3,  3, 1,  1, 1,  1, 0)   // out_h 5 (odd)

    nn_se_disp_pointwise(5, 5, 3, 4)                              // out_h 5 (odd)
    nn_se_disp_pointwise(4, 4, 2, 6)
    nn_se_disp_pointwise(7, 2, 2, 5)                              // out_h 7 (odd)
    nn_se_disp_pointwise(1, 3, 4, 3)                              // out_h 1

    //             in_h in_w in_c  dm  kh kw  sh sw  ph pw
    nn_se_disp_dw(    5,   5,   3,  1,  3, 3,  1, 1,  1, 1)       // out_h 5 (odd)
    nn_se_disp_dw(    4,   4,   2,  2,  3, 3,  2, 2,  1, 1)       // out_h 2, dm 2
    nn_se_disp_dw(    7,   3,   2,  1,  3, 3,  2, 1,  1, 1)       // out_h 4
    nn_se_disp_dw(    9,   4,   1,  3,  3, 3,  1, 1,  1, 1)       // out_h 9 (odd), dm 3
    nn_se_disp_dw(    3,   3,   4,  1,  3, 3,  1, 1,  2, 2)       // out_h 5, pad > k/2
    nn_se_disp_dw(    4,   4,   2,  1,  4, 4,  4, 4,  0, 0)       // out_h 1
    nn_se_disp_dw(    5,   5,   2,  1,  3, 1,  1, 1,  1, 0)       // out_h 5, ph != pw

    nn_se_disp_pool(5, 7, 5, 2, 2, 2, 2, 2, 0, 0)                 // out_h 3 (odd)
    nn_se_disp_pool(5, 7, 7, 3, 3, 3, 2, 2, 1, 1)                 // out_h 4
    nn_se_disp_pool(5, 9, 4, 1, 3, 3, 1, 1, 1, 1)                 // out_h 9 (odd)
    nn_se_disp_pool(5, 5, 5, 2, 3, 3, 2, 2, 1, 1)                 // out_h 3 (odd)
    nn_se_disp_pool(5, 4, 4, 2, 4, 4, 4, 4, 0, 0)                 // out_h 1
    nn_se_disp_pool(5, 6, 6, 2, 3, 2, 2, 2, 1, 0)                 // out_h 3, ph != pw
    nn_se_disp_pool(10, 7, 5, 2, 2, 2, 2, 2, 0, 0)
    nn_se_disp_pool(10, 7, 7, 3, 3, 3, 2, 2, 1, 1)
    nn_se_disp_pool(10, 9, 4, 1, 3, 3, 1, 1, 1, 1)
    nn_se_disp_pool(10, 5, 5, 2, 3, 3, 2, 2, 1, 1)
    nn_se_disp_pool(10, 4, 4, 2, 4, 4, 4, 4, 0, 0)
    nn_se_disp_pool(10, 6, 6, 2, 3, 2, 2, 2, 1, 0)

    nn_se_disp_resize(3, 2, 2, 3, 2)                              // out_h 9 (odd)
    nn_se_disp_resize(2, 3, 1, 2, 1)                              // out_h 4
    nn_se_disp_resize(5, 2, 3, 1, 2)                              // out_h 5 (odd)
    nn_se_disp_resize(1, 1, 4, 7, 7)                              // out_h 7 (odd)
}

fn main() {
    if cli_argc > 1 { nn_se_perturb = 1 }
    nn_se_run()
    print_str("checks=")
    nn_se_emit_u32(nn_se_checks)
    print_str(" fails=")
    nn_se_emit_u32(nn_se_fails)
    print_str("\n")
    if nn_se_fails != 0 { exit(1) }
    // A harness that silently ran nothing must not report success.
    if nn_se_checks < 200 {
        print_str("ERROR: too few comparisons — harness did not run\n")
        exit(2)
    }
    exit(0)
}
