// tests/nn/nn_par_esp32.mlr — Stage 4, Tasks 5/6: TWO-CORE model inference on
// real ESP32 silicon.
//
// Task 5 wired the four ELEMENTWISE opcodes and measured a net LOSS (0.762x
// against true single core), because a second ESP32 core that is merely awake
// costs core 0 ~45% in instruction-fetch contention. Task 6 adds the six
// SPATIAL opcodes, split on output ROWS, and keeps core 1 RUNSTALLed whenever
// it is not inside a split band — the mechanism tests/esp32/par_tax.mlr and
// tests/esp32/par_park_cost.mlr established. nn_park_layers is that shape;
// nn_par_layers is Task 5's, kept for continuity.
//
// This is nn_model_esp32.mlr with a second core attached. Core 0 walks the
// layer table exactly as std/nn_model.mlr's nn_model_run_prefix does; for a
// layer on the opt-in split list it publishes a work descriptor, runs the low
// half itself and lets core 1 run the high half; for anything else it runs the
// whole layer alone. Both cores hit ONE barrier per layer either way.
//
// Build + flash (the .krnn is what selects the model):
//   mlrc --arch=xtensa --freestanding --target=esp32 \
//        --model smoke.krnn tests/nn/nn_par_esp32.mlr -o par.bin
//   ~/esp32_flash.sh par.bin && ~/esp32_run.sh 90 out.txt
//
// ─────────────────────────────────────────────────────────────────────────
// THE INVARIANT, AND WHY IT IS STRUCTURAL RATHER THAN REMEMBERED
// ─────────────────────────────────────────────────────────────────────────
// For EVERY layer, both cores call par_barrier() exactly once. Not once per
// SPLIT layer — once per layer, including op 0 (NOP), which nn_model_exec
// returns from immediately without touching a byte.
//
// If one core ever skipped a barrier the two would desynchronise by one round
// and every subsequent layer would read half-written data. That does not
// present as a sync bug; it presents as numbers that are wrong in a way that
// looks like memory corruption, on a board with no debugger.
//
// So the barrier here is NOT inside the split branch. In nn_par_layers it is
// the last statement of the loop body, outside the if/else, and in
// core1_entry it is the last statement of the take loop, outside the
// `if kind`. A new opcode branch cannot forget it, because there is nowhere
// to put a branch that skips it. par_publish is placed the same way: exactly
// one call, ahead of the branch, so "publish once per barrier" — the rule
// std/esp32_par.mlr's single-slot descriptor depends on — is also structural.
//
// A non-splittable layer therefore parks core 1 AT THE BARRIER. Core 1 still
// takes a fresh descriptor for that round; it just gets PARK and does nothing.
// It is never left spinning on a stale one.
//
// ─────────────────────────────────────────────────────────────────────────
// WHAT MAKES THE SPLIT SAFE
// ─────────────────────────────────────────────────────────────────────────
//   * Disjoint bytes. The four opt-in ops (4 RELU, 6 ADD, 8 SIGMOID_LUT,
//     9 COPY) are per-element maps over one flat index space, so [0, mid) and
//     [mid, n) name disjoint output bytes. tests/esp32/par_coherency.mlr
//     proved on this chip that two cores writing disjoint byte ranges with
//     plain store8 are coherent across a handshake.
//   * Correct bands. tests/nn/nn_split_equiv.mlr sweeps EVERY split point on
//     the host, against both the kernels and nn_model_exec_range itself. If
//     silicon disagrees with the host, the bug is here, in the wiring — that
//     is the entire point of having proven the kernels separately first.
//   * Ordering. Layer i's inputs are layer i-1's outputs, and the barrier at
//     the end of round i-1 is what makes both halves of i-1 visible before
//     either core starts i.
//
// ─────────────────────────────────────────────────────────────────────────
// IT MEASURES ITSELF: SAME BINARY, PARALLELISM OFF THEN ON
// ─────────────────────────────────────────────────────────────────────────
// Each iteration runs the model TWICE — once with par_on = 0, so every layer
// publishes PARK and core 0 does all the work, then once with par_on = 1 —
// and prints CCOUNT cycles for both plus the graph outputs for both. Same
// image, same clock, same cache state, back to back, so the two numbers are
// directly comparable and neither can be blamed on a build difference.
//
// Printing BOTH output blocks also makes byte-exactness self-checking on the
// board: the serial block and the parallel block must be identical to each
// other AND to tests/nn/nn_model_ref.py.
//
// Three cycle counts are reported per run:
//   TOT  the whole layer loop, barriers and publishes included
//   EW   time inside the four opt-in ops only — core 0's share of it. In the
//        serial run this is the ENTIRE elementwise cost, i.e. the numerator of
//        the Amdahl bound on what any elementwise-only split can ever win.
//   BAR  time inside par_barrier(), summed over every layer. This is the price
//        of the invariant, and it is paid on non-splittable layers too.
//
// ─────────────────────────────────────────────────────────────────────────
// The rest — the model at 0x3FFB0000, the two UART device blocks (errata
// CPU-3.3), the PLL-before-first-putc rule, the run-forever loop for a board
// with no DTR/RTS — is unchanged from nn_model_esp32.mlr, which documents all
// four at length.
import "nn_model_core.mlr"
import "../../std/esp32_clk.mlr"
import "../../std/esp32_smp.mlr"
import "../../std/esp32_par.mlr"

// UART_STATUS_REG — APB. Poll only; never write the FIFO through this block.
device UartStatus at 0x3FF40000 {
    status at 0x1C : u32
}

// UART0 TX FIFO — AHB mirror. Errata CPU-3.3: the byte MUST go here.
device UartFifo at 0x60000000 {
    fifo at 0x00 : u32
}

fn nn_mt_putc(u8 c) {
    // ⚠️ `&` binds TIGHTER than `>>` here, so the shift must be parenthesized.
    while ((UartStatus.status >> 16) & 0xFF) >= 126 { }
    UartFifo.fifo = c
}

// CCOUNT. @naked + rsr into a2 (the CALL0 return register) + ret; see
// tests/nn/nn_prof_esp32.mlr for why this needs no prologue.
@naked fn nn_par_ccount() -> u32 {
    asm("rsr.ccount a2")
    asm("ret")
    // Unreachable — the asm ret already returned. Present only because sema
    // requires a value-returning function to return on every path.
    return 0
}

// Same 73728 B arena as the other two esp32 drivers, so one image shape covers
// the smoke model, YuNet@64 and YuNet@96 and the cap check still refuses a
// 128 px model loudly.
static u8[73728] nn_mt_arena

fn nn_mt_arena_p() -> u32 {
    return nn_mt_arena
}

fn nn_mt_arena_cap() -> u32 {
    u32 v = 73728
    return v
}

// ---------------------------------------------------------------------------
// Core 1's stack, and why one canary word would not do
// ---------------------------------------------------------------------------
// Core 1 has 4 KiB: XT_ESP32_CORE1_STACK == 0x3FFDEFF0, frames in
// (0x3FFDE000, 0x3FFDEFF0]. From Task 6 on it runs the deepest nests in the
// codebase — nn_model_exec_range -> nn_conv2d_int8_rows -> nn_dot_i8_run, and
// for a pointwise layer nn_conv2d_int8_rows is entered directly with its
// twenty arguments — and ir_xtensa.mlr's own comment warns that a SINGLE frame
// may legitimately reach 32752 bytes.
//
// What is directly below core 1's floor is .bss, and in this program .bss is
// the ACTIVATION ARENA. An overflow therefore does not fault; it rewrites
// activations, and the result is wrong numbers that look exactly like a
// cross-core race. So this has to be detected, not hoped away.
//
// Three separate things are placed, because they fail differently:
//
//   1. A GUARD BAND of NN_C1_BAND_BYTES below the floor, filled with
//      NN_C1_BAND_PAT. A single canary word is not enough: a frame larger than
//      4 bytes can step clean over one word and land in the arena undetected,
//      and the whole point of the 32752-byte warning is that frames here can be
//      enormous. Core 0 scans the band for the LOWEST disturbed word, which
//      says how far past the floor core 1 actually reached.
//   2. The two single-word guards std/esp32_smp.mlr already names. The one at
//      ESP32_C0_GUARD_ADDR (0x3FFDF000) is load-bearing for (3): core 0 runs
//      the same deep nests, and it must cross that word to reach core 1's span
//      at all. If it is intact, the low-water mark below is core 1's alone.
//   3. A low-water fill over core 1's own span, exactly Stage 1's C1LOW: the
//      lowest address still holding NN_C1_FILL is core 1's high-water mark, so
//      the report says how close core 1 came even when it never crossed.
//
// If the band is ever disturbed, STOP. The fix is a memory-map change — moving
// core 1's stack, or shrinking the arena — not a retry.
//
// THE BAND IS 4 KiB, AND THAT IT IS FREE MEMORY IS MEASURED, NOT ASSUMED.
// xt_esp32_check_layout refuses a build whose .data+.bss reach past
// 0x3FFDE000, so the largest dummy static that still compiles equals the free
// space between the top of .bss and core 1's floor exactly. Binary-searching
// that on THIS driver with the smoke model gives 111128 bytes: .bss ends at
// 0x3FFC2DE8 and the band at [0x3FFDD000, 0x3FFDE000) sits 108 KiB clear of it.
// With a real 89 KB YuNet blob the whole of .data/.bss moves up by ~86 KB and
// the band still clears the arena by ~21 KiB. Re-run that probe if either the
// arena or the model grows a lot.
//
// It is also self-detecting: if a static ever DID overlap the band, nn_par_poison
// writes 0x5A over the whole arena before every single run, so the very first
// report would show the band disturbed. Overlap and overflow both stop the run;
// they are told apart by re-running the probe, not by guessing.
//
// 4 KiB below the floor plus core 1's own 4 KiB span is 8 KiB of contiguous
// covered memory, so no plausible frame steps over the whole of it — and the
// low-water mark says what the frames actually cost, which is the number that
// settles the 32752-byte question empirically.
static u32 NN_C1_FILL       = 0xEEEEEEEE
static u32 NN_C1_BAND_PAT   = 0xB0DEC0DE
static u32 NN_C1_BAND_BYTES = 4096

fn nn_c1_band_base() -> u32 {
    return ESP32_C1_GUARD_ADDR - NN_C1_BAND_BYTES
}

// ⚠️ Call from core 0 only, AFTER the single-core baseline and BEFORE
// esp32_appcpu_start. Core 0's own live frames sit above ESP32_C0_GUARD_ADDR
// while this runs (it is called straight out of main), so the fill cannot
// destroy the return address it comes back through — the failure
// examples/esp32/dualcore_hello.mlr warns about.
fn nn_c1_stack_prep() {
    u32 a = nn_c1_band_base()
    while a < ESP32_C1_GUARD_ADDR {
        vstore32(a, NN_C1_BAND_PAT)
        a = a + 4
    }
    vstore32(ESP32_C1_GUARD_ADDR, NN_C1_BAND_PAT)
    vstore32(ESP32_C0_GUARD_ADDR, NN_C1_BAND_PAT)
    a = ESP32_C1_GUARD_ADDR + 4
    while a < ESP32_CORE1_STACK_TOP {
        vstore32(a, NN_C1_FILL)
        a = a + 4
    }
}

fn nn_par_hex32(u32 v) {
    u32 i = 0
    while i < 8 {
        u32 d = (v >> (28 - (i * 4))) & 0xF
        if d < 10 {
            nn_mt_putc(d + 48)
        } else {
            nn_mt_putc((d - 10) + 65)
        }
        i = i + 1
    }
}

// BAND is 0 when the band below the floor is untouched, and otherwise the
// LOWEST disturbed address — i.e. how deep past its floor core 1 went. Anything
// but 0 means stop.
fn nn_c1_stack_report() {
    u32 bad = 0
    u32 a = nn_c1_band_base()
    while a < ESP32_C1_GUARD_ADDR {
        if vload32(a) != NN_C1_BAND_PAT {
            bad = a
            break
        }
        a = a + 4
    }
    u32 lo = ESP32_C1_GUARD_ADDR + 4
    while lo < ESP32_CORE1_STACK_TOP {
        if vload32(lo) != NN_C1_FILL { break }
        lo = lo + 4
    }
    nn_mt_str("GUARD BAND ")
    nn_par_hex32(bad)
    nn_mt_str(" FLOOR ")
    nn_par_hex32(vload32(ESP32_C1_GUARD_ADDR))
    nn_mt_str(" C0 ")
    nn_par_hex32(vload32(ESP32_C0_GUARD_ADDR))
    nn_mt_str(" C1LOW ")
    nn_par_hex32(lo)
    nn_mt_str(" C1USED ")
    nn_mt_emit_u32(ESP32_CORE1_STACK_TOP - lo)
    nn_mt_str(" C1FREE ")
    nn_mt_emit_u32(lo - ESP32_C1_GUARD_ADDR)
    nn_mt_putc(10)
}

// ---------------------------------------------------------------------------
// The enable ladder
// ---------------------------------------------------------------------------
// The brief enables the opcodes one at a time and checks byte-exactness after
// each. Doing that with six BUILDS would change code layout six times, and code
// layout is the variable every cycle number in this file is trying to hold
// still. So the ladder is a runtime MASK instead: one image, one boot, one
// cache state, seven stages, each with its own full output dump.
//
// The mask ANDs with nn_model_op_splittable(), it does not replace it — the
// library predicate stays the only place an opcode is declared safe to split,
// and the mask can only ever take ops AWAY from it.
static u32[1] nn_par_mask

fn nn_par_split_ok(u32 op) -> u32 {
    if nn_model_op_splittable(op) == 0 { return 0 }
    // ⚠️ `&` binds TIGHTER than `>>` in this dialect, so the shift MUST be
    // parenthesised — `m >> op & 1` would parse as `m >> (op & 1)`.
    if ((vload32(nn_par_mask) >> op) & 1) == 0 { return 0 }
    return 1
}

// Core-1 handshake and the three cycle accumulators. Written by core 0 only,
// except c1_ready which core 1 polls.
static u32[1] nn_par_c1_ready
static u32[1] nn_par_tot
static u32[1] nn_par_ew
static u32[1] nn_par_bar
static u32[1] nn_par_base_tot
static u32[1] nn_par_base_ew

// Per-layer cycle profile, for the load-balance question the brief's Step 4
// asks. Three numbers per layer:
//   nn_par_base_lay  core 0 alone, core 1 in reset — the serial cost
//   nn_par_c0_lay    core 0's own band, in the parked parallel run
//   nn_par_c1_lay    core 1's band for the SAME layer, timed by core 1 itself
//
// c1 is passed through a single slot rather than indexed by core 1, because
// core 1 does not know the layer index and giving it one would mean a second
// copy of a fact core 0 already holds. The barrier is what makes the handoff
// safe: core 1 stores its count BEFORE par_barrier(), so by the time core 0
// leaves the same barrier the store has happened.
//
// max(C0, C1) is what the layer actually costs wall-clock; |C0 - C1| is the
// skew a static half-split leaves on the table. 16 slots covers the 12-layer
// smoke model; the writes are bounds-checked, so a larger model simply
// profiles its first 16 layers instead of corrupting the next static.
static u32[16] nn_par_base_lay
static u32[16] nn_par_c0_lay
static u32[16] nn_par_c1_lay
static u32[1]  nn_par_c1_last

// ---------------------------------------------------------------------------
// Core 1
// ---------------------------------------------------------------------------
// Take a job, maybe run it, barrier. Forever — core 1 has no idea how many
// layers there are and does not need one: core 0 publishes exactly once per
// barrier round, so the two loop counts match by construction, and between
// inferences core 1 simply blocks inside par_take() waiting for the next
// round's descriptor. That is a wait for something FRESH, not a spin on
// something stale.
fn core1_entry() {
    EspSmpDport.appcpu_ctrl_d = 0          // disarm; every dual-core file does this
    loop { if vload32(nn_par_c1_ready) != 0 { break } }   // wait for par_init
    loop {
        u32 kind = par_take()
        // Timed from AFTER par_take returns, so this is core 1's WORK only.
        // Whatever it costs to wake core 1 out of RUNSTALL is deliberately not
        // in here — it shows up in core 0's BAR instead, which is where it
        // belongs and where it can be told apart from genuine skew.
        u32 ca = nn_par_ccount()
        if kind == 1 {
            nn_model_exec_range(par_job_a0(), par_job_a1(), par_job_a2(),
                                par_job_lo(), par_job_hi())
        }
        u32 cb = nn_par_ccount()
        vstore32(nn_par_c1_last, (cb - ca) & 0xFFFFFFFF)
        par_barrier()
    }
}

// ---------------------------------------------------------------------------
// Core 0
// ---------------------------------------------------------------------------
// par_on = 0 makes every layer publish PARK, which is the single-core control:
// same code path, same barriers, same publishes, all the work on core 0.
fn nn_par_layers(u32 m, u32 arena, u32 par_on) -> u32 {
    u32 bad = nn_model_check(m)
    if bad != 0 { return bad }
    u32 lay = m + load32(m + 16)
    u32 stride = load32(m + 20)
    u32 blob = m + load32(m + 32)
    u32 total = nn_model_layer_count(m)
    u32 ew = 0
    u32 bar = 0
    u32 t_start = nn_par_ccount()
    u32 i = 0
    while i < total {
        u32 r = lay + (i * stride)
        // The extent of THIS layer's split space — output rows for a spatial
        // op, flat elements for an elementwise one. nn_model_split_n() is the
        // one place that distinction is made; nothing here needs to know which
        // family the layer belongs to.
        u32 n = nn_model_split_n(r)
        // `mid` is where core 0 stops. For a PARK round it is n, so even a
        // core 1 that ignored `kind` would be handed the empty range [n, n).
        u32 mid = n
        u32 kind = 0
        u32 splittable = nn_par_split_ok(load32(r))
        if par_on != 0 {
            if splittable != 0 {
                mid = nn_model_split_mid(r)
                kind = 1
            }
        }
        par_publish(kind, r, arena, blob, mid, n)

        u32 t0 = nn_par_ccount()
        if kind != 0 {
            nn_model_exec_range(r, arena, blob, 0, mid)
        } else {
            nn_model_exec(r, arena, blob)
        }
        u32 t1 = nn_par_ccount()
        if splittable != 0 { ew = (ew + ((t1 - t0) & 0xFFFFFFFF)) & 0xFFFFFFFF }

        // UNCONDITIONAL. Outside the branch above, on purpose. See the header.
        par_barrier()

        u32 t2 = nn_par_ccount()
        bar = (bar + ((t2 - t1) & 0xFFFFFFFF)) & 0xFFFFFFFF
        i = i + 1
    }
    u32 t_end = nn_par_ccount()
    vstore32(nn_par_tot, (t_end - t_start) & 0xFFFFFFFF)
    vstore32(nn_par_ew, ew)
    vstore32(nn_par_bar, bar)
    return 0
}

// THE TRUE SINGLE-CORE BASELINE, and why it needs its own function.
//
// nn_par_layers with par_on = 0 is NOT a single-core baseline. Core 1 is
// released by then, so it spends every one of core 0's layers spinning inside
// par_barrier's wait loop, issuing a load from shared internal SRAM as fast as
// it can. That contends for the same memory the kernels are streaming through,
// and it taxes core 0 heavily — measured at roughly 45% on this board. Reporting
// PAR against that baseline would credit the split with undoing a cost the
// split's own machinery created.
//
// So this runs BEFORE esp32_appcpu_start, with core 1 still in reset: no
// barrier, no publish, no second core in existence. It is deliberately a
// SEPARATE function rather than a flag on nn_par_layers, because the whole
// point of nn_par_layers is that its barrier cannot be skipped by any branch.
//
// ⚠️ MUST be called only while core 1 is in reset. Calling it afterwards would
// leave core 1 waiting for a barrier that never comes.
fn nn_par_base_layers(u32 m, u32 arena) -> u32 {
    u32 bad = nn_model_check(m)
    if bad != 0 { return bad }
    u32 lay = m + load32(m + 16)
    u32 stride = load32(m + 20)
    u32 blob = m + load32(m + 32)
    u32 total = nn_model_layer_count(m)
    u32 ew = 0
    u32 t_start = nn_par_ccount()
    u32 i = 0
    while i < total {
        u32 r = lay + (i * stride)
        u32 t0 = nn_par_ccount()
        nn_model_exec(r, arena, blob)
        u32 t1 = nn_par_ccount()
        if nn_par_split_ok(load32(r)) != 0 {
            ew = (ew + ((t1 - t0) & 0xFFFFFFFF)) & 0xFFFFFFFF
        }
        if i < 16 { vstore32(nn_par_base_lay + (i * 4), (t1 - t0) & 0xFFFFFFFF) }
        i = i + 1
    }
    u32 t_end = nn_par_ccount()
    vstore32(nn_par_base_tot, (t_end - t_start) & 0xFFFFFFFF)
    vstore32(nn_par_base_ew, ew)
    return 0
}

// ---------------------------------------------------------------------------
// Core 0, PARKED variant — the Task 6 shape, measured against the same BASE
// ---------------------------------------------------------------------------
// tests/esp32/par_tax.mlr established that the ~45% tax the comment above
// records is core 1's INSTRUCTION FETCH, and that it vanishes to the cycle when
// core 1 stops issuing — under five independent mechanisms, including DPORT
// APPCPU_RUNSTALL, which core 0 can assert and release for ~150 cycles a round
// with no interrupt plumbing on core 1 (tests/esp32/par_park_cost.mlr).
//
// So this variant keeps core 1 STALLED except inside a split band. That changes
// the barrier discipline, and the change is the whole point:
//
//   nn_par_layers  every layer publishes and barriers, so core 1 must be
//                  running for every layer, so it spins through all of them.
//   nn_park_layers only SPLITTABLE layers publish and barrier. A
//                  non-splittable layer does not involve core 1 at all, so
//                  core 1 stays stalled through it and costs core 0 nothing.
//
// The invariant is still structural, just a different one: `unstall, publish,
// work, barrier, stall` is a single straight-line block with no branch inside
// it, so core 1's round count still equals core 0's publish count and the
// single-slot descriptor is still safe. Parking core 1 immediately after core 0
// leaves the barrier is safe in both arrival orders — if core 0 arrived second
// it has already flipped `sense` and core 1 resumes into a satisfied wait; if
// core 0 arrived first it only left because core 1 flipped `sense`, which is
// after core 1's own barrier work is done.
//
// ⚠️ Core 1 must be stalled on entry and is stalled on exit, so this may only
// be called with core 1 sitting in par_take, never mid-barrier.
fn nn_park_runstall(u32 on) {
    if on != 0 {
        EspSmpDport.appcpu_ctrl_c = EspSmpDport.appcpu_ctrl_c | 1
    } else {
        EspSmpDport.appcpu_ctrl_c = EspSmpDport.appcpu_ctrl_c & 0xFFFFFFFE
    }
}

fn nn_park_layers(u32 m, u32 arena) -> u32 {
    u32 bad = nn_model_check(m)
    if bad != 0 { return bad }
    u32 lay = m + load32(m + 16)
    u32 stride = load32(m + 20)
    u32 blob = m + load32(m + 32)
    u32 total = nn_model_layer_count(m)
    u32 ew = 0
    u32 bar = 0
    nn_park_runstall(1)
    u32 t_start = nn_par_ccount()
    u32 i = 0
    while i < total {
        u32 r = lay + (i * stride)
        u32 n = nn_model_split_n(r)
        u32 t0 = 0
        u32 t1 = 0
        u32 c1 = 0
        if nn_par_split_ok(load32(r)) != 0 {
            u32 mid = nn_model_split_mid(r)
            nn_park_runstall(0)
            par_publish(1, r, arena, blob, mid, n)
            t0 = nn_par_ccount()
            nn_model_exec_range(r, arena, blob, 0, mid)
            t1 = nn_par_ccount()
            par_barrier()
            nn_park_runstall(1)
            u32 t2 = nn_par_ccount()
            // Safe only after the barrier: core 1 stored this before arriving.
            c1 = vload32(nn_par_c1_last)
            ew = (ew + ((t1 - t0) & 0xFFFFFFFF)) & 0xFFFFFFFF
            bar = (bar + ((t2 - t1) & 0xFFFFFFFF)) & 0xFFFFFFFF
        } else {
            t0 = nn_par_ccount()
            nn_model_exec(r, arena, blob)
            t1 = nn_par_ccount()
        }
        if i < 16 {
            vstore32(nn_par_c0_lay + (i * 4), (t1 - t0) & 0xFFFFFFFF)
            vstore32(nn_par_c1_lay + (i * 4), c1)
        }
        i = i + 1
    }
    u32 t_end = nn_par_ccount()
    nn_park_runstall(1)
    vstore32(nn_par_tot, (t_end - t_start) & 0xFFFFFFFF)
    vstore32(nn_par_ew, ew)
    vstore32(nn_par_bar, bar)
    return 0
}

// Per-layer profile of the LAST parked run, next to the single-core cost of the
// same layer. SER is what one core paid; C0/C1 are the two bands of the parallel
// run. A layer where C0 and C1 differ a lot is a static-half-split skew, and the
// fix for that is a shared atomic work counter, not a tweak here.
fn nn_par_dump_layers(u32 m) {
    u32 total = nn_model_layer_count(m)
    u32 i = 0
    while i < total {
        if i < 16 {
            u32 r = nn_model_layer_rec(m, i)
            nn_mt_str("LAY ")
            nn_mt_emit_u32(i)
            nn_mt_str(" op ")
            nn_mt_emit_u32(load32(r))
            nn_mt_str(" n ")
            nn_mt_emit_u32(nn_model_split_n(r))
            nn_mt_str(" mid ")
            nn_mt_emit_u32(nn_model_split_mid(r))
            nn_mt_str(" SER ")
            nn_mt_emit_u32(vload32(nn_par_base_lay + (i * 4)))
            nn_mt_str(" C0 ")
            nn_mt_emit_u32(vload32(nn_par_c0_lay + (i * 4)))
            nn_mt_str(" C1 ")
            nn_mt_emit_u32(vload32(nn_par_c1_lay + (i * 4)))
            nn_mt_putc(10)
        }
        i = i + 1
    }
}

fn nn_par_report(u32 tag) {
    nn_mt_str(tag)
    nn_mt_str(" MASK ")
    nn_par_hex32(vload32(nn_par_mask))
    nn_mt_str(" TOT ")
    nn_mt_emit_u32(vload32(nn_par_tot))
    nn_mt_str(" EW ")
    nn_mt_emit_u32(vload32(nn_par_ew))
    nn_mt_str(" BAR ")
    nn_mt_emit_u32(vload32(nn_par_bar))
    nn_mt_putc(10)
}

// POISON THE ARENA BEFORE EVERY RUN. This is not hygiene, it is the only thing
// that makes the parallel run's output mean anything.
//
// The serial run happens first and leaves the CORRECT answer in every
// intermediate tensor. Without this, a parallel run that failed to write some
// band — core 1 never started, took a stale descriptor, or ran the empty range
// — would read the previous run's values straight through and print a
// byte-perfect result. That is not hypothetical: a deliberately broken build
// with core 1's nn_model_exec_range call removed printed output identical to
// tools/ml/nn_model_ref.py's golden, on this board, before this function
// existed. It only got caught because its cycle counts were wrong.
//
// 0x5A is the same poison tests/nn/nn_split_equiv.mlr uses. Only the model's
// declared arena_bytes are poisoned, not the whole 72 KiB static, and this runs
// OUTSIDE the timed region in nn_par_layers, so it does not enter TOT.
fn nn_par_poison(u32 m) {
    u32 p = nn_mt_arena_p()
    u32 n = nn_model_arena_bytes(m)
    u32 i = 0
    while i < n {
        store8(p + i, 0x5A)
        i = i + 1
    }
}

// One inference. Poisons the arena and refills the input every time, so the two
// runs of an iteration start from identical state and neither can inherit the
// other's answers.
fn nn_par_run(u32 m, u32 par_on, u32 tag) -> u32 {
    u32 bad = nn_model_check(m)
    if bad != 0 {
        nn_mt_str("ERR:model ")
        nn_mt_emit(bad)
        return bad
    }
    if nn_model_arena_bytes(m) > nn_mt_arena_cap() {
        nn_mt_str("ERR:arena ")
        nn_mt_emit(nn_model_arena_bytes(m))
        return 4
    }
    nn_par_poison(m)
    nn_mt_fill_input(m)
    bad = nn_par_layers(m, nn_mt_arena_p(), par_on)
    if bad != 0 {
        nn_mt_str("ERR:run ")
        nn_mt_emit(bad)
        return bad
    }
    nn_par_report(tag)
    nn_mt_emit_outputs(m)
    return 0
}

// The parked variant's run wrapper. Same poison + fill + dump as nn_par_run, so
// its output block is directly comparable with the others — and it has to be:
// the whole claim is that parking core 1 changes only the cycles, not a byte.
fn nn_park_run(u32 m) -> u32 {
    u32 bad = nn_model_check(m)
    if bad != 0 {
        nn_mt_str("ERR:model ")
        nn_mt_emit(bad)
        return bad
    }
    if nn_model_arena_bytes(m) > nn_mt_arena_cap() {
        nn_mt_str("ERR:arena ")
        nn_mt_emit(nn_model_arena_bytes(m))
        return 4
    }
    nn_par_poison(m)
    nn_mt_fill_input(m)
    bad = nn_park_layers(m, nn_mt_arena_p())
    if bad != 0 {
        nn_mt_str("ERR:run ")
        nn_mt_emit(bad)
        return bad
    }
    nn_par_report("PARK")
    nn_mt_emit_outputs(m)
    return 0
}

// One rung of the enable ladder: set the mask, then run the parked variant.
// The output dump that follows is what makes the rung byte-checkable on its
// own — every rung must print the same 120 values as BASE and as
// tests/nn/nn_model_ref.py, or that opcode's row split is wrong.
fn nn_park_stage(u32 m, u32 mask) -> u32 {
    vstore32(nn_par_mask, mask)
    return nn_park_run(m)
}

// The baseline's own run wrapper. Same poison + fill + dump as nn_par_run, so
// its output block is directly comparable with the other two.
fn nn_par_base_run(u32 m) -> u32 {
    u32 bad = nn_model_check(m)
    if bad != 0 {
        nn_mt_str("ERR:model ")
        nn_mt_emit(bad)
        return bad
    }
    if nn_model_arena_bytes(m) > nn_mt_arena_cap() {
        nn_mt_str("ERR:arena ")
        nn_mt_emit(nn_model_arena_bytes(m))
        return 4
    }
    nn_par_poison(m)
    nn_mt_fill_input(m)
    bad = nn_par_base_layers(m, nn_mt_arena_p())
    if bad != 0 {
        nn_mt_str("ERR:run ")
        nn_mt_emit(bad)
        return bad
    }
    nn_mt_str("BASE TOT ")
    nn_mt_emit_u32(vload32(nn_par_base_tot))
    nn_mt_str(" EW ")
    nn_mt_emit_u32(vload32(nn_par_base_ew))
    nn_mt_putc(10)
    nn_mt_emit_outputs(m)
    return 0
}

// ~1 s at 240 MHz, so a human or a `cat` can see the gap between iterations.
fn nn_par_delay() {
    u32 i = 0
    while i < 24000000 {
        i = i + 1
    }
}

fn main() {
    // PLL first, before any putc — the UART divisor is rewritten in here.
    u32 clkrc = esp32_clk_cpu_pll(240)
    u32 model = 0x3FFB0000
    nn_mt_str("CLK ")
    nn_mt_emit_u32(clkrc)
    nn_mt_putc(10)
    nn_mt_str("BOOT ")
    nn_mt_emit_u32(load32(model))
    nn_mt_putc(10)

    // ---- the true single-core baseline, core 1 still in reset ----
    // The mask is FULL here so BASE's EW is core 0's time in every op the
    // ladder can ever split — the Amdahl numerator for the whole ladder, not
    // for one rung of it.
    vstore32(nn_par_mask, 0xFFFFFFFF)
    nn_mt_str("BEGIN BASE\n")
    u32 rcb = nn_par_base_run(model)
    nn_mt_str("END BASE ")
    nn_mt_emit_u32(rcb)
    nn_mt_putc(10)

    // Guard band goes down AFTER the baseline (so core 0's own deep frames
    // during BASE cannot be mistaken for core 1's) and BEFORE core 1 exists.
    nn_c1_stack_prep()
    nn_c1_stack_report()                   // the pristine reading, for contrast

    par_init()                             // before releasing core 1
    esp32_appcpu_start(fn_addr("core1_entry"))
    vstore32(nn_par_c1_ready, 1)
    loop {
        nn_mt_str("CLK ")
        nn_mt_emit_u32(clkrc)
        nn_mt_putc(10)
        nn_mt_str("BOOT ")
        nn_mt_emit_u32(load32(model))
        nn_mt_putc(10)
        nn_mt_str("BASE TOT ")
        nn_mt_emit_u32(vload32(nn_par_base_tot))
        nn_mt_str(" EW ")
        nn_mt_emit_u32(vload32(nn_par_base_ew))
        nn_mt_putc(10)
        // Task 5's two shapes first, for continuity: core 1 released and
        // spinning in the barrier for every layer, split off then on.
        vstore32(nn_par_mask, 0xFFFFFFFF)
        nn_mt_str("BEGIN SERIAL\n")
        u32 rc0 = nn_par_run(model, 0, "SERIAL")
        nn_mt_str("BEGIN PAR\n")
        u32 rc1 = nn_par_run(model, 1, "PAR")

        // Core 1 is sitting in par_take here, which is the only state
        // nn_park_layers may be entered from.
        //
        // THE LADDER. Ops are added in the brief's order — 5 maxpool, 10
        // avgpool, 7 resize, 3 pointwise, 2 depthwise, 1 conv2d — each rung
        // dumping its own 120 values. conv2d is last because it is the deepest
        // nest and the largest share of the work.
        //
        //   PK0  0x00000000  nothing split: core 1 stays RUNSTALLed for the
        //                    whole inference. The parked-serial control, and
        //                    the number BASE should be within noise of.
        //   PKE  0x00000350  4 RELU, 6 ADD, 8 SIGMOID_LUT, 9 COPY   (Task 5)
        //   PK5  0x00000370  + 5  MAXPOOL
        //   PKA  0x00000770  + 10 AVGPOOL
        //   PK7  0x000007F0  + 7  RESIZE_NN
        //   PK3  0x000007F8  + 3  POINTWISE
        //   PK2  0x000007FC  + 2  DEPTHWISE
        //   PK1  0x000007FE  + 1  CONV2D
        u32 rc2 = nn_park_stage(model, 0x00000000)
        rc2 = rc2 + nn_park_stage(model, 0x00000350)
        rc2 = rc2 + nn_park_stage(model, 0x00000370)
        rc2 = rc2 + nn_park_stage(model, 0x00000770)
        rc2 = rc2 + nn_park_stage(model, 0x000007F0)
        rc2 = rc2 + nn_park_stage(model, 0x000007F8)
        rc2 = rc2 + nn_park_stage(model, 0x000007FC)
        rc2 = rc2 + nn_park_stage(model, 0x000007FE)
        nn_par_dump_layers(model)

        nn_park_runstall(0)                // back to spinning for the next SERIAL
        nn_c1_stack_report()
        nn_mt_str("END ")
        nn_mt_emit_u32((rc0 + rc1) + rc2)
        nn_mt_putc(10)
        nn_par_delay()
    }
}
