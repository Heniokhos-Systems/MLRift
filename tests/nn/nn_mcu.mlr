// tests/nn/nn_mcu.mlr — freestanding MCU driver for the int8 kernel numeric
// validation. Same body as tests/nn/nn_host.mlr; only the character sink
// differs. Output must be byte-identical to the host run and to nn_ref.py.
//
// Build + run (xtensa):
//   mlrc --arch=xtensa --freestanding tests/nn/nn_mcu.mlr -o /tmp/nn.elf
//   qemu-system-xtensa -M lx60 -nographic -kernel /tmp/nn.elf
//
// The lx60 UART is a 16550 at 0xfd050020 (thr u32 @0x00, lsr u8 @0x14) —
// NOT the ESP32's 0x3FF40000. Spin until the TX holding register is empty
// (LSR bit 5) before writing, or characters are dropped.
import "nn_test_core.mlr"

device Uart at 0xfd050020 {
    thr at 0x00 : u32
    lsr at 0x14 : u8
}

fn nn_t_putc(u8 c) {
    while (Uart.lsr & 0x20) == 0 { }
    Uart.thr = c
}

// Freestanding: there is nothing to return to. Falling off the end of main
// executes whatever follows it in .text, which silently produces no output.
fn main() {
    nn_t_run()
    nn_t_putc(69)
    nn_t_putc(78)
    nn_t_putc(68)
    nn_t_putc(10)
    loop { }
}
