// tests/nn/nn_host.mlr — host (x86_64/arm64) driver for the int8 kernel
// numeric validation. Output must match tests/nn/nn_ref.py exactly.
import "nn_test_core.mlr"

static u8[2] nn_h_cbuf

fn nn_t_putc(u8 c) {
    u32 p = nn_h_cbuf
    store8(p, c)
    store8(p + 1, 0)
    print_str(p)
}

fn main() {
    nn_t_run()
    exit(0)
}
