// tests/nn/nn_model_mcu_riscv.mlr — freestanding riscv32 driver for the
// std/nn_model.mlr runner validation. Same body as nn_model_host.mlr /
// nn_model_mcu.mlr; only where the model comes from and where characters go
// differ.
//
// Build + run:
//   mlrc --arch=riscv32 --freestanding tests/nn/nn_model_mcu_riscv.mlr \
//        -o /tmp/nn.bin
//   qemu-system-riscv32 -M virt -nographic -bios /tmp/nn.bin \
//       -device loader,file=model.krnn,addr=0x81000000,force-raw=on
//
// The model is loaded next to the image rather than compiled into it — see
// the header of tests/nn/nn_model_mcu.mlr for why. riscv32 --freestanding
// runs in machine mode with no translation, so the loader address and the
// address the runner reads are the same.
//
// --freestanding riscv32 emits a FLAT image mapped at 0x8000_0000 (see
// src/ir_riscv.mlr rv_emit_raw_sp_preamble), which is what `-bios` loads.
// virt's console is an NS16550A at 0x1000_0000 with 1-byte registers:
// THR @0x00, LSR @0x05 (bit 5 = transmit holding register empty).
import "nn_model_core.mlr"

device Uart at 0x10000000 {
    thr at 0x00 : u8
    lsr at 0x05 : u8
}

fn nn_mt_putc(u8 c) {
    while (Uart.lsr & 0x20) == 0 { }
    Uart.thr = c
}

// Exactly YuNet@128's peak arena (nn_model_core.mlr owns the contract). All
// zeros, and declared after nn_mt_seed = 12345 in the imported core, so the
// trailing-zero trim keeps it out of the image file.
static u8[131072] nn_mt_arena

fn nn_mt_arena_p() -> u32 {
    return nn_mt_arena
}

fn nn_mt_arena_cap() -> u32 {
    u32 v = 131072
    return v
}

fn main() {
    u32 model = 0x81000000
    nn_mt_run(model, 1000000, 1, 0)
    nn_mt_putc(69)
    nn_mt_putc(78)
    nn_mt_putc(68)
    nn_mt_putc(10)
    loop { }
}
