}


// ---------------------------------------------------------------------------
// S12/S13 — pooling
// ---------------------------------------------------------------------------

fn nn_t_s12() {
    u32 ip = nn_t_in
    u32 op = nn_t_out
    i32 lo = 0 - 128

    nn_t_srand(1234567)
    nn_t_fill(ip, 50)

    nn_maxpool_int8(ip, 5, 5, 2, op, 2, 2, 2, 2, 0, 0, lo, 127)
    nn_t_dump(op, 8)
    nn_maxpool_int8(ip, 5, 5, 2, op, 3, 3, 2, 2, 1, 1, lo, 127)
    nn_t_dump(op, 18)
    nn_avgpool_int8(ip, 5, 5, 2, op, 2, 2, 2, 2, 0, 0, lo, 127)
    nn_t_dump(op, 8)
    nn_avgpool_int8(ip, 5, 5, 2, op, 3, 3, 2, 2, 1, 1, lo, 127)
    nn_t_dump(op, 18)
}


// ---------------------------------------------------------------------------
// S14 — activations
// ---------------------------------------------------------------------------

fn nn_t_s14() {
    u32 ip = nn_t_in
    u32 op = nn_t_out

    nn_t_srand(20260724)
    nn_t_fill(ip, 24)

    nn_t_copy(op, ip, 24)
    i32 zp = 0 - 7
    nn_relu_int8(op, 24, zp)
    nn_t_dump(op, 24)

    nn_t_copy(op, ip, 24)
    nn_relu6_int8(op, 24, 3, 100)
    nn_t_dump(op, 24)
}


// ---------------------------------------------------------------------------
// S15 — quantized elementwise add
// ---------------------------------------------------------------------------

fn nn_t_s15() {
    u32 ap = nn_t_in
    u32 bp = nn_t_in2
    u32 op = nn_t_out

    nn_t_srand(555)
    nn_t_fill(ap, 24)
    nn_t_fill(bp, 24)

    i32 m = 1 << 30
    i32 azp = 0 - 2
    i32 as_ = 0 - 1
    i32 bs = 0 - 2
    i32 os = 0 - 20
    i32 lo = 0 - 128
    nn_add_int8(ap, azp, m, as_, bp, 4, m, bs, op, 6, m, os, 24, 20, lo, 127)
    nn_t_dump(op, 24)
}


// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// S16 — end-to-end detector-shaped stack
//
//   8x8x1 int8 "image"
//     -> conv 3x3 stride 2 pad 1, 4 channels      -> 4x4x4
//     -> relu (quantized domain, zero point 0)
//     -> depthwise 3x3 stride 1 pad 1             -> 4x4x4
//     -> pointwise 1x1, 2 channels                -> 4x4x2
//     -> global average pool 4x4                  -> 1x1x2
//
// The WEIGHTS ARE SYNTHETIC (pseudo-random). This exercises the shape of a
// tiny MobileNet-style face-detection head and proves the stack composes on
// an MCU; it is NOT a trained detector and the two output values mean nothing.
//
// Buffer plan inside the 256-byte scratch tensors (no aliasing between the
// input and output of any stage):
//   nn_t_wt  +0   conv weights (36)   +64 depthwise (36)   +128 pointwise (8)
//   nn_t_out +0   conv/relu (64)      +64 depthwise (64)
//            +128 pointwise (32)      +160 pooled (2)
// ---------------------------------------------------------------------------

fn nn_t_s16() {
    u32 ip = nn_t_in
    u32 wp = nn_t_wt
    u32 op = nn_t_out
    u32 bp = nn_t_bias
    u32 mp = nn_t_mult
    u32 sp = nn_t_shift
    i32 lo = 0 - 128

    nn_t_srand(777001)
    nn_t_fill(ip, 64)

    // stage 1 — conv 3x3 stride 2 pad 1, 1 -> 4 channels
    nn_t_fill(wp, 36)
    nn_t_fill_bias(4)
    nn_t_fill_mult(4)
    nn_t_fill_shift(4)
    i32 izp = 0 - 5
    nn_conv2d_int8(ip, 8, 8, 1, izp, wp, 3, 3, bp, mp, sp, 1, op, 4, 0,
                   2, 2, 1, 1, lo, 127)

    // stage 2 — ReLU in the quantized domain (output zero point is 0)
    nn_relu_int8(op, 64, 0)

    // stage 3 — depthwise 3x3 stride 1 pad 1
    u32 wp2 = wp + 64
    u32 op2 = op + 64
    nn_t_fill(wp2, 36)
    nn_t_fill_bias(4)
    nn_t_fill_mult(4)
    nn_t_fill_shift(4)
    nn_depthwise_conv2d_int8(op, 4, 4, 4, 0, wp2, 3, 3, bp, mp, sp, 1, op2, 0,
                             1, 1, 1, 1, 1, lo, 127)

    // stage 4 — pointwise 1x1, 4 -> 2 channels
    u32 wp3 = wp + 128
    u32 op3 = op + 128
    nn_t_fill(wp3, 8)
    nn_t_fill_bias(2)
    nn_t_fill_mult(2)
    nn_t_fill_shift(2)
    nn_pointwise_conv_int8(op2, 4, 4, 4, 0, wp3, bp, mp, sp, 1, op3, 2, 0,
                           lo, 127)

    // stage 5 — global average pool
    u32 op4 = op + 160
    nn_avgpool_int8(op3, 4, 4, 2, op4, 4, 4, 4, 4, 0, 0, lo, 127)

    nn_t_dump(op, 64)
    nn_t_dump(op2, 64)
    nn_t_dump(op3, 32)
    nn_t_dump(op4, 2)
}


// stage 17 — nn_requantize_zp (the flattened hot path) must equal
// nn_requantize_zp_ref (the composed definition) for every input.
//
// It is here rather than in a test of its own so it runs on all THREE targets
// the rest of this file already covers. That matters: the host carries u32 in
// 64-bit slots and does not wrap, so an inlining mistake that only appears
// under genuine 32-bit truncation would be invisible to a host-only check.
// The emitted value is the disagreement count, and the reference says 0.
fn nn_t_s17() {
    nn_t_emit_u32(nn_requantize_selftest())
    nn_t_putc(10)
}


fn nn_t_run() {
    nn_t_s1()
    nn_t_s1b()
    nn_t_s2()
    nn_t_s3()
    nn_t_s4()
    nn_t_s5()
    nn_t_s6()
    nn_t_s7()
    nn_t_s8a()
    nn_t_s8b()
    nn_t_s9()
    nn_t_s10()
    nn_t_s11()
    nn_t_s12()
    nn_t_s14()
    nn_t_s15()
    nn_t_s16()
    nn_t_s17()
}
