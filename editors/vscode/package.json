{
  "name": "mlrift",
  "displayName": "MLRift",
  "description": "Syntax highlighting, live diagnostics, and IntelliSense (completions, hover, go-to-definition) for MLRift — the self-hosted systems language for ML/GPU workloads (.mlr), targeting AMD GPUs (HIP/AMDGPU) and embedded MCUs (ESP32/Xtensa, RISC-V).",
  "version": "1.1.0",
  "keywords": [
    "mlrift",
    "mlr",
    "systems programming",
    "machine learning",
    "gpu",
    "amdgpu",
    "compiler",
    "embedded",
    "self-hosted"
  ],
  "publisher": "Pantelis23",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Heniokhos-Systems/MLRift"
  },
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:mlrift"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mlrift",
        "aliases": [
          "MLRift",
          "mlr"
        ],
        "extensions": [
          ".mlr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mlr-file.svg",
          "dark": "./icons/mlr-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mlrift",
        "scopeName": "source.mlr",
        "path": "./syntaxes/mlrift.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "MLRift",
      "properties": {
        "mlrift.compilerPath": {
          "type": "string",
          "default": "mlrc",
          "description": "Path to the mlrc compiler binary"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node && esbuild src/server.ts --bundle --outfile=out/server.js --format=cjs --platform=node",
    "package": "npx vsce package"
  }
}
